        if (m) return v;

        m = v.match(/^(\d{2})-(\d{2})-(\d{4})$/);
        if (m) return `${m[3]}-${m[2]}-${m[1]}`;

        return frappe.datetime.get_today();
    }

    function sales_period_range() {

        const period = $(".sales-period-btn.active").data("sales-period") || "MTD";

        if (
            period === "Custom" &&
            window.sales_dashboard_custom_from &&
            window.sales_dashboard_custom_to
        ) {
            return {
                from: window.sales_dashboard_custom_from,
                to: window.sales_dashboard_custom_to
            };
        }

        const to = dashboard_date_iso();
        const d = new Date(`${to}T12:00:00`);

        let from = new Date(d);

        if (period === "YTD") {
            from = new Date(d.getFullYear(), 0, 1);
        } else if (period === "QTD") {
            const quarter_start = Math.floor(d.getMonth() / 3) * 3;
            from = new Date(d.getFullYear(), quarter_start, 1);
        } else {
            from = new Date(d.getFullYear(), d.getMonth(), 1);
        }

        const iso = dt => {
            const y = dt.getFullYear();
            const m = String(dt.getMonth() + 1).padStart(2, "0");
            const day = String(dt.getDate()).padStart(2, "0");
            return `${y}-${m}-${day}`;
        };

        return {
            from: iso(from),
            to: to
        };
    }

    function open_sales_list(doctype, filters = {}) {
        frappe.route_options = filters;
        frappe.set_route("List", doctype);
    }

    function between(field, range) {
        return [field, ["between", [range.from, range.to]]];
    }

    // -----------------------------
    // CUSTOM PERIOD
    // -----------------------------
    $(document)
        .off("click.salesCustom", ".sales-period-btn")
        .on("click.salesCustom", ".sales-period-btn", function (e) {

            const period = $(this).data("sales-period");

            if (period !== "Custom") {
                return;
            }

            e.preventDefault();
            e.stopImmediatePropagation();

            const today = dashboard_date_iso();
            const default_from =
                window.sales_dashboard_custom_from ||
                `${today.slice(0, 7)}-01`;

            const default_to =
                window.sales_dashboard_custom_to ||
                today;

            const dialog = new frappe.ui.Dialog({
                title: "Custom Sales Period",
                fields: [
                    {
                        fieldname: "from_date",
                        fieldtype: "Date",
                        label: "From Date",
                        reqd: 1,
                        default: default_from
                    },
                    {
                        fieldname: "to_date",
                        fieldtype: "Date",
                        label: "To Date",
                        reqd: 1,
                        default: default_to
                    }
                ],
                primary_action_label: "Apply",
                primary_action(values) {

                    if (values.from_date > values.to_date) {
                        frappe.msgprint("From Date cannot be after To Date");
                        return;
                    }

                    window.sales_dashboard_custom_from = values.from_date;
                    window.sales_dashboard_custom_to = values.to_date;

                    $(".sales-period-btn").removeClass("active");
                    $('.sales-period-btn[data-sales-period="Custom"]')
                        .addClass("active");

                    dialog.hide();

                    load_sales_dashboard(
                        values.to_date,
                        "Custom",
                        values.from_date,
                        values.to_date
                    );
                }
            });

            dialog.show();
        });


    // -----------------------------
    // SALES KPI CLICK
    // -----------------------------
    $(document)
        .off("click.salesKPI")
        .on("click.salesKPI",
            "#sales-detail-revenue, #sales-detail-order-value, " +
            "#sales-detail-open-quotations, #sales-detail-orders, " +
            "#sales-detail-pending",
            function () {

                const id = this.id;
                const range = sales_period_range();

                if (id === "sales-detail-revenue") {

                    open_sales_list("Sales Invoice", {
                        docstatus: 1,
                        is_return: 0,
                        posting_date: ["between", [range.from, range.to]]
                    });

                } else if (id === "sales-detail-order-value") {

                    open_sales_list("Sales Order", {
                        docstatus: 1,
                        transaction_date: ["between", [range.from, range.to]]
                    });

                } else if (id === "sales-detail-open-quotations") {

                    open_sales_list("Quotation", {
                        docstatus: 1,
                        transaction_date: ["between", [range.from, range.to]]
                    });

                } else if (id === "sales-detail-orders") {

                    open_sales_list("Sales Order", {
                        docstatus: 1,
                        transaction_date: ["between", [range.from, range.to]]
                    });

                } else if (id === "sales-detail-pending") {

                    open_sales_list("Sales Order", {
                        docstatus: 1,
                        transaction_date: ["between", [range.from, range.to]],
                        per_delivered: ["<", 100],
                        status: ["not in", [
                            "Completed",
                            "Closed",
                            "Cancelled"
                        ]]
                    });
                }
            }
        );


    // -----------------------------
    // PIPELINE CLICK
    // -----------------------------
    $(document)
        .off("click.salesPipeline",
            "#sales-pipe-open, #sales-pipe-ordered, " +
            "#sales-pipe-lost, #sales-pipe-expired, " +
            "#sales-pipeline-open, #sales-pipeline-ordered, " +
            "#sales-pipeline-lost, #sales-pipeline-expired"
        )
        .on("click.salesPipeline",
            "#sales-pipe-open, #sales-pipe-ordered, " +
            "#sales-pipe-lost, #sales-pipe-expired, " +
            "#sales-pipeline-open, #sales-pipeline-ordered, " +
            "#sales-pipeline-lost, #sales-pipeline-expired",
            function () {

                const range = sales_period_range();
                const id = this.id;

                const filters = {
                    docstatus: 1,
                    transaction_date: ["between", [range.from, range.to]]
                };

                if (
                    id.includes("open")
                ) {
                    filters.status = [
                        "in",
                        ["Open", "Replied", "Partially Ordered"]
                    ];
                } else if (id.includes("ordered")) {
                    filters.status = "Ordered";
                } else if (id.includes("lost")) {
                    filters.status = "Lost";
                } else if (id.includes("expired")) {
                    filters.status = "Expired";
                }

                open_sales_list("Quotation", filters);
            }
        );


