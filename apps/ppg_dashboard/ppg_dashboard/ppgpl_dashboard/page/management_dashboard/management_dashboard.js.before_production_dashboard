function kpi_card(title, value, sub, section, doctype) {

    return `
        <div class="md-kpi clickable-kpi"
             data-section="${section}"
             data-doctype="${doctype}">

            <div class="kpi-label">
                ${title}
            </div>

            <div class="kpi-value"
                 id="kpi-${slug(title)}">
                ${value}
            </div>

            <div class="kpi-sub"
                 id="kpi-sub-${slug(title)}">
                ${sub}
            </div>

        </div>
    `;
}


function summary_stat(id, label, doctype = "") {

    return `
        <div class="summary-stat clickable-summary"
             data-doctype="${doctype}">

            <span>${label}</span>

            <strong id="${id}">0</strong>

            ${
                doctype
                ? '<small>View ↗</small>'
                : ''
            }

        </div>
    `;
}


function flow_item(id, label) {

    return `
        <div class="flow-item">
            <div class="flow-number" id="${id}">0</div>
            <div class="flow-label">${label}</div>
        </div>
    `;
}


function slug(text) {

    return text
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-|-$/g, "");
}


function initialize_controls() {

    $("#dashboard-date").val(
        frappe.datetime.get_today()
    );

    $(".md-tab").on("click", function () {

        $(".md-tab").removeClass("active");
        $(this).addClass("active");

        filter_dashboard(
            $(this).data("section")
        );
    });


    $("#dashboard-date").on(
        "change",
        load_dashboard
    );


    $("#dashboard-period").on(
        "change",
        load_dashboard
    );


    $("#refresh-dashboard").on(
        "click",
        load_dashboard
    );

    // Apply default All-tab visibility on initial load
    filter_dashboard("All");


    $(document).on("click", ".open-list", function () {

        const doctype = $(this).data("doctype");

        if (!doctype) {
            return;
        }

        frappe.set_route(
            "List",
            doctype
        );
    });


    $(document).on("click", ".clickable-kpi", function () {

        const doctype = $(this).data("doctype");

        if (!doctype) {
            return;
        }

        frappe.set_route(
            "List",
            doctype
        );
    });


    update_last_updated();

    load_dashboard();
}


function load_dashboard() {

    const date = $("#dashboard-date").val();
    const period = $("#dashboard-period").val();

    $("#refresh-dashboard").prop("disabled", true);

    frappe.call({
        method: "ppg_dashboard.api.management_dashboard.get_dashboard_data",

        args: {
            as_of_date: date,
            period: period
        },

        callback: function (r) {

            console.log("Management Dashboard Full Response:", r);
            console.log("Management Dashboard HR:", r.message?.hr);

            if (!r || !r.message) {
                frappe.msgprint({
                    title: "Dashboard Error",
                    message: "No dashboard data returned.",
                    indicator: "red"
                });
                return;
            }

            render_data(r.message);
            load_sales_dashboard(date, period);
        },

        error: function (r) {

            console.error(
                "Management Dashboard API error:",
                r
            );

            frappe.msgprint({
                title: "Dashboard Error",
                message: "Unable to load dashboard data.",
                indicator: "red"
            });
        },

        always: function () {

            $("#refresh-dashboard").prop(
                "disabled",
                false
            );

            update_last_updated();
        }
    });
}

