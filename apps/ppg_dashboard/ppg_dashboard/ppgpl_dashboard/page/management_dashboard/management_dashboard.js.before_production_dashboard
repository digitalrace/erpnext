function render_alerts(alerts) {

    const container = $("#management-alerts");

    container.empty();

    $("#alert-count").text(
        alerts.length
    );


    if (!alerts.length) {

        container.html(`
            <div class="empty-state">
                No critical alerts
            </div>
        `);

        return;
    }


    alerts.forEach(function (alert) {

        container.append(`
            <div class="attention-row ${alert.type || ""}">

                <div>
                    <strong>
                        ${frappe.utils.escape_html(alert.message)}
                    </strong>
                </div>

                <div class="alert-number">
                    ${format_number(alert.count)}
                </div>

            </div>
        `);

    });
