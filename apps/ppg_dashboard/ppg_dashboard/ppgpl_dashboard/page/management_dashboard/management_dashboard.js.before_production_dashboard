    }

    .business-flow {
        display: flex;
        overflow-x: auto;
        justify-content: flex-start;
        padding-bottom: 8px;
    }

    .flow-item {
        min-width: 110px;
    }

    .flow-arrow {
        min-width: 28px;
    }
}

@media (max-width: 800px) {

    .management-dashboard {
        padding: 14px;
