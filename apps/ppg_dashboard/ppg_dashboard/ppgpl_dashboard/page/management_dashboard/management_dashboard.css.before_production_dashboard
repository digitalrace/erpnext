.management-dashboard {
    background: #f7f8fa;
    min-height: calc(100vh - 60px);
    padding: 22px 26px 40px;
    color: #172033;
}

.md-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 18px;
}

.md-title {
    font-size: 25px;
    font-weight: 700;
}

.md-subtitle {
    margin-top: 4px;
    color: #7b8494;
    font-size: 12px;
}

.md-actions {
    display: flex;
    align-items: flex-end;
    gap: 8px;
}

.md-actions > div {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.md-actions label {
    font-size: 10px;
    color: #7b8494;
    margin: 0;
}

.md-actions input {
    width: 145px;
}

.md-actions select {
    width: 88px;
}

.md-refresh {
    height: 36px;
}

.md-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 16px;
}

.md-tab {
    border: 1px solid #d9dee7;
    background: #fff;
    color: #536070;
    border-radius: 8px;
    padding: 7px 14px;
    font-size: 12px;
    cursor: pointer;
}

.md-tab.active {
    background: #edf4ff;
    color: #1758bb;
    border-color: #8fb7fa;
    font-weight: 600;
}

.md-kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 15px;
}

.md-kpi {
    background: #fff;
    border: 1px solid #e0e5ec;
    border-radius: 10px;
    padding: 15px 16px;
    min-height: 104px;
}

.kpi-label {
    color: #697386;
    font-size: 11px;
}

.kpi-value {
    margin-top: 7px;
    font-size: 24px;
    font-weight: 700;
    color: #111827;
}

.kpi-sub {
    margin-top: 7px;
    font-size: 11px;
    color: #7b8494;
}

.md-card {
    background: #fff;
    border: 1px solid #e0e5ec;
    border-radius: 10px;
    padding: 17px;
    margin-bottom: 15px;
}

.md-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 15px;
}

.md-card-header h4 {
    margin: 0;
    font-size: 15px;
    font-weight: 650;
}

.md-card-header span {
    display: block;
    margin-top: 3px;
    color: #8a94a4;
    font-size: 10px;
}

.md-two-column {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

.summary-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
}

.summary-stat {
    background: #fafbfc;
    border: 1px solid #edf0f3;
    border-radius: 8px;
    padding: 12px;
}

.summary-stat span {
    display: block;
    color: #737e8d;
    font-size: 10px;
}

.summary-stat strong {
    display: block;
    margin-top: 6px;
    font-size: 18px;
}

.clickable-summary {
    cursor: pointer;
}

.clickable-summary:hover {
    background: #f7faff;
    border-color: #a8c5f5;
}

.business-flow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    overflow-x: auto;
    gap: 10px;
    padding: 8px 0;
}

.flow-item {
    min-width: 100px;
    text-align: center;
}

.flow-number {
    font-size: 23px;
    font-weight: 700;
}

.flow-label {
    margin-top: 5px;
    color: #707b8a;
    font-size: 10px;
}

.flow-arrow {
    color: #aab3bf;
    font-size: 18px;
}

.progress-row {
    display: flex;
    justify-content: space-between;
    margin-top: 15px;
    color: #737e8d;
    font-size: 11px;
}

.progress-track {
    height: 8px;
    background: #eef1f4;
    border-radius: 20px;
    overflow: hidden;
    margin-top: 7px;
}

.progress-value {
    width: 0;
    height: 100%;
    background: #3478d4;
    border-radius: 20px;
}

.md-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 11px;
}

.md-table th {
    padding: 8px;
    text-align: left;
    color: #7a8493;
    border-bottom: 1px solid #dfe4ea;
}

.md-table td {
    padding: 9px 8px;
    border-bottom: 1px solid #edf0f3;
}

.clickable-row {
    cursor: pointer;
}

.clickable-row:hover td {
    background: #f7faff;
}

/* HR */

.hr-kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
}

.hr-kpi-grid .summary-stat {
    min-height: 95px;
}

.hr-card-present {
    background: #f0fdf4 !important;
    border-left: 4px solid #16a34a !important;
}

.hr-card-present strong {
    color: #15803d;
}

.hr-card-absent {
    background: #fef2f2 !important;
    border-left: 4px solid #dc2626 !important;
}

.hr-card-absent strong {
    color: #dc2626;
}

.hr-card-leave {
    background: #fffbeb !important;
    border-left: 4px solid #f59e0b !important;
}

.hr-card-leave strong {
    color: #b45309;
}

.hr-card-half {
    background: #eff6ff !important;
    border-left: 4px solid #3b82f6 !important;
}

.hr-card-half strong {
    color: #2563eb;
}

.hr-card-attendance {
    background: #f5f3ff !important;
    border-left: 4px solid #7c3aed !important;
}

.hr-card-attendance strong {
    color: #6d28d9;
}

.hr-card-pending {
    background: #fff7ed !important;
    border-left: 4px solid #f97316 !important;
}

.hr-card-pending strong {
    color: #ea580c;
}

.hr-source-info {
    display: flex;
    gap: 28px;
    margin-top: 12px;
    padding: 10px 12px;
    background: #f8fafc;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
}

.hr-source-info div {
    display: flex;
    gap: 7px;
    align-items: center;
}

.hr-source-info span {
    color: #7b8494;
    font-size: 10px;
}

.hr-source-info strong {
    font-size: 10px;
}

.hr-absent-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
}

.hr-absent-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px;
    background: #fffafa;
    border: 1px solid #f2dada;
    border-left: 3px solid #dc2626;
    border-radius: 8px;
    cursor: pointer;
}

.hr-absent-row:hover {
    background: #fff1f1;
}

.hr-avatar {
    width: 32px;
    height: 32px;
    min-width: 32px;
    border-radius: 50%;
    background: #fee2e2;
    color: #b91c1c;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
}

.hr-employee-info {
    min-width: 0;
    flex: 1;
}

.hr-employee-info strong {
    display: block;
    font-size: 11px;
}

.hr-employee-info span {
    display: block;
    margin-top: 2px;
    color: #8b95a3;
    font-size: 9px;
}

.hr-absent-status {
    color: #b91c1c;
    font-size: 9px;
    font-weight: 650;
}

.hr-empty {
    padding: 25px;
    text-align: center;
    color: #8b95a3;
    font-size: 11px;
}

.hr-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
}

.hr-status-dot.red {
    background: #dc2626;
}

.hr-status-dot.green {
    background: #16a34a;
}

@media (max-width: 1000px) {
    .md-kpi-grid,
    .hr-kpi-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .md-two-column {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 600px) {
    .md-kpi-grid,
    .hr-kpi-grid {
        grid-template-columns: 1fr;
    }

    .hr-absent-list {
        grid-template-columns: 1fr;
    }
}

/* HR compact management layout */
.hr-kpi-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    gap: 10px !important;
}

.hr-kpi-grid .summary-stat {
    min-height: 88px !important;
    padding: 11px !important;
}

.hr-absent-list {
    grid-template-columns: 1fr !important;
    max-height: 330px;
    overflow-y: auto;
}

.hr-absent-row {
    padding: 8px 10px !important;
}

@media (min-width: 1100px) {
    .section-box[data-sections="HR"] + .section-box[data-sections="HR"] {
        width: 50%;
    }
}


@media (min-width: 1100px) {
    .hr-absent-section {
        width: 50%;
    }
}

@media (max-width: 1099px) {
    .hr-absent-section {
        width: 100%;
    }
}



/* =========================================================
   SALES MANAGEMENT DASHBOARD - REFERENCE STYLE
   ========================================================= */

.sales-dashboard-section {
    padding: 0 !important;
    border: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
}

.sales-ref-card {
    background: #ffffff;
    border: 1px solid #e3e6eb;
    border-radius: 12px;
    padding: 14px;
    margin-bottom: 12px;
}

.sales-dashboard-section > .sales-ref-card {
    margin-bottom: 0;
}

.sales-ref-header {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 12px;
}

.sales-ref-header h3 {
    margin: 0;
    font-size: 17px;
    font-weight: 600;
    color: #202124;
}

.sales-ref-header > span {
    width: 100%;
    margin-top: -3px;
    font-size: 12px;
    color: #6f7784;
}

.sales-ref-view {
    margin-left: auto;
    font-size: 13px;
    padding: 7px 13px;
    border: 1px solid #cfd4dc;
    border-radius: 8px;
    background: #fff;
    color: #2d333b;
    cursor: pointer;
}

.sales-ref-view:hover {
    background: #f8f9fb;
}

.sales-period-row {
    display: flex;
    gap: 7px;
    margin-bottom: 14px;
    flex-wrap: wrap;
}

.sales-period-row .sales-period-btn {
    font-size: 13px;
    padding: 7px 15px;
    border-radius: 18px;
    border: 1px solid #cfd4dc;
    background: #fff;
    color: #555f6d;
    cursor: pointer;
}

.sales-period-row .sales-period-btn.active {
    background: #202124;
    color: #fff;
    border-color: #202124;
}

.sales-reference-kpi {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 9px;
    margin-bottom: 13px;
}

.sales-reference-k {
    background: #fff;
    border: 1px solid #e4e7ec;
    border-radius: 9px;
    padding: 12px;
    min-height: 93px;
}

.sales-reference-k p {
    margin: 0;
    font-size: 12px;
    color: #737b87;
}

.sales-reference-k strong {
    display: block;
    font-size: 21px;
    line-height: 1.15;
    font-weight: 600;
    margin: 4px 0 5px;
    color: #202124;
}

.sales-reference-k small {
    display: block;
    font-size: 11px;
    color: #6f7784;
}

.sales-reference-two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 13px;
    margin-bottom: 13px;
}

.sales-reference-two > .sales-reference-card {
    margin-bottom: 0;
    background: #f8f9fb;
}

.sales-reference-title {
    margin: 0 0 11px;
    font-size: 13px;
    display: flex;
    justify-content: space-between;
    gap: 10px;
    align-items: center;
}

.sales-reference-title strong {
    font-weight: 600;
    color: #202124;
}

.sales-reference-title span {
    font-size: 11px;
    font-weight: 400;
    color: #737b87;
}

.sales-reference-segment {
    display: flex;
    height: 17px;
    border-radius: 9px;
    overflow: hidden;
    margin-bottom: 9px;
    background: #e9edf2;
}

.sales-reference-segment span {
    display: block;
    height: 100%;
}

#sales-pipe-open {
    background: #2a78d6;
}

#sales-pipe-ordered {
    background: #0ca30c;
}

#sales-pipe-lost {
    background: #d03b3b;
}

#sales-pipe-expired {
    background: #a3a39b;
}

.sales-reference-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    font-size: 11px;
    color: #6f7784;
    margin-bottom: 12px;
}

.sales-reference-legend span {
    display: flex;
    align-items: center;
    gap: 4px;
}

.sales-reference-legend i {
    width: 10px;
    height: 10px;
    display: inline-block;
    border-radius: 2px;
}

.sales-reference-legend b {
    color: #202124;
    font-weight: 500;
}

.sr-blue {
    background: #2a78d6;
}

.sr-green {
    background: #0ca30c;
}

.sr-red {
    background: #d03b3b;
}

.sr-gray {
    background: #a3a39b;
}

.sr-orange {
    background: #eb6834;
}

.sr-subtitle {
    margin-top: 13px;
}

.sales-reference-expiring {
    max-height: 175px;
    overflow-y: auto;
}

.sales-expiring-row {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 8px;
    padding: 8px 0;
    border-bottom: 1px solid #e3e6eb;
    font-size: 12px;
}

.sales-expiring-row:last-child {
    border-bottom: none;
}

.sales-expiring-row > div span {
    display: block;
    font-size: 11px;
    color: #737b87;
    margin-top: 2px;
}

.sales-days-pill {
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 14px;
    min-width: 48px;
    text-align: center;
}

.sales-days-pill.normal {
    background: #fff0d0;
    color: #8b6400;
}

.sales-days-pill.warning {
    background: #ffe0ae;
    color: #855000;
}

.sales-days-pill.danger {
    background: #ffd9d9;
    color: #b32929;
}

.sales-reference-chart {
    height: 110px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 8px;
    padding-top: 2px;
}

.sales-month-column {
    flex: 1;
    height: 100%;
    display: flex;
    align-items: flex-end;
    gap: 2px;
}

.sales-month-bars {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: flex-end;
    gap: 2px;
}

.sales-bar {
    flex: 1;
    min-height: 4px;
    border-radius: 3px 3px 0 0;
}

.sales-bar.orders {
    background: #2a78d6;
}

.sales-bar.revenue {
    background: #eb6834;
}

.sales-month-column > span {
    display: none;
}

.sales-reference-chart-labels {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: #7a828e;
    margin-top: 4px;
}

.sales-reference-legend.chart {
    margin: 8px 0 0;
}

.sr-aging-title {
    margin-top: 14px;
}

.sales-reference-aging > div {
    display: grid;
    grid-template-columns: 62px 1fr 64px;
    align-items: center;
    gap: 8px;
    margin: 8px 0;
    font-size: 12px;
}

.aging-track {
    height: 8px;
    background: #edf0f4;
    border-radius: 4px;
    overflow: hidden;
}

.aging-track > div {
    height: 100%;
    border-radius: 4px;
    min-width: 3px;
}

#sales-aging-0-30 {
    background: #0ca30c;
}

#sales-aging-31-60 {
    background: #fab219;
}

#sales-aging-61-90 {
    background: #eb6834;
}

#sales-aging-90-plus {
    background: #d03b3b;
}

.sales-reference-aging b {
    text-align: right;
    font-weight: 500;
}

.sales-reference-card.sales-team-reference {
    margin-bottom: 13px;
}

.sales-reference-table-wrap {
    overflow-x: auto;
}

.sales-reference-table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    font-size: 12px;
}

.sales-reference-table th {
    text-align: left;
    font-weight: 400;
    color: #737b87;
    padding: 7px 8px 7px 0;
    border-bottom: 1px solid #e1e5ea;
    white-space: nowrap;
}

.sales-reference-table td {
    padding: 8px 8px 8px 0;
    border-bottom: 1px solid #e5e8ed;
    white-space: nowrap;
}

.sales-reference-table tr:last-child td {
    border-bottom: none;
}

.sales-avatar {
    display: inline-flex;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #e2efff;
    color: #2468b5;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    margin-right: 6px;
    vertical-align: middle;
}

.sales-target-bar {
    display: inline-block;
    vertical-align: middle;
    width: 72px;
    height: 7px;
    background: #eef0f3;
    border-radius: 4px;
    overflow: hidden;
    margin-right: 6px;
}

.sales-target-bar i {
    display: block;
    height: 100%;
    border-radius: 4px;
    background: #0ca30c;
}

.sales-green-text {
    color: #16831a !important;
}

.sales-warning-text {
    color: #9a6900 !important;
}

.sales-red-text {
    color: #bb3030 !important;
}

.sales-empty-cell {
    text-align: center !important;
    color: #8a929d !important;
}

.sales-bottom-reference {
    margin-bottom: 0;
}

.sales-reference-tabs {
    display: flex;
    gap: 4px;
    border-bottom: 1px solid #dde1e6;
    margin-bottom: 10px;
    flex-wrap: wrap;
}

.sales-reference-tabs .sales-data-tab {
    font-size: 13px;
    padding: 7px 13px;
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    color: #6e7682;
    cursor: pointer;
}

.sales-reference-tabs .sales-data-tab.active {
    color: #202124;
    border-bottom-color: #202124;
}

.sales-status-pill {
    display: inline-block;
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 14px;
    background: #fff0d0;
    color: #8b6400;
}

.sales-reference-table .sales-danger-text {
    color: #c33232 !important;
}

@media (max-width: 1100px) {

    .sales-reference-kpi {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

}

@media (max-width: 700px) {

    .sales-reference-kpi {
        grid-template-columns: 1fr;
    }

    .sales-reference-two {
        grid-template-columns: 1fr;
    }

}


/* SALES MONTH CHART CLICKABLE */

.sales-month-column {
    position: relative;
    cursor: pointer;
}

.sales-month-value-popup {
    display: none;
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    transform: translateX(-50%);
    min-width: 160px;
    padding: 9px 11px;
    background: var(--surface-2);
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    box-shadow: 0 6px 18px rgba(0,0,0,.14);
    z-index: 50;
    font-size: 11px;
    line-height: 1.6;
    white-space: nowrap;
}

.sales-month-value-popup strong {
    display: block;
    margin-bottom: 3px;
    font-size: 12px;
}

.sales-month-column.selected .sales-month-value-popup {
    display: block;
}
