function render_sales_team(rows) {

    const body = $("#sales-team-body");

    body.empty();

    if (!rows.length) {

        body.html(`
            <tr>
                <td colspan="6" class="sales-empty-cell">
                    No Sales Person data available.
                </td>
            </tr>
        `);

        return;
    }

    rows.forEach(function(row) {

        const target = Number(row.target || 0);

        const achievement =
            target
                ? Math.min(
                    100,
                    (
                        Number(row.order_value || 0)
                        / target
                    ) * 100
                )
                : 0;

        const initials =
            String(
                row.sales_person_name ||
                row.sales_person ||
                "SP"
            )
            .split(/\s+/)
            .filter(Boolean)
            .slice(0, 2)
            .map(x => x.charAt(0).toUpperCase())
            .join("");

        body.append(`

            <tr>

                <td>
                    <span class="sales-avatar">
                        ${sales_escape(initials)}
                    </span>

                    ${sales_escape(
                        row.sales_person_name ||
                        row.sales_person ||
                        "-"
                    )}
