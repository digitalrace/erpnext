})();

/*
 * Birthday section renderer for the HR tab of the Management Dashboard.
 * render_data(data) calls render_birthday_dashboard(data).
 */
(function () {
	"use strict";

	const METHOD = "ppg_dashboard.api.birthday_dashboard.get_birthdays";
	const STYLE_ID = "ppgb-style";

	const CSS = `
.ppgb{font-size:13px;color:var(--text-color,#1f272e)}
.ppgb *{box-sizing:border-box}
.ppgb-head{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;flex-wrap:wrap;margin-bottom:12px}
.ppgb-title{font-size:16px;font-weight:600}
.ppgb-muted{color:var(--text-muted,#6b7280);font-size:12px}
.ppgb-h{margin:14px 0 8px;font-weight:600}
.ppgb-h span{font-weight:400;color:var(--text-muted,#6b7280);font-size:11px;margin-left:6px}
.ppgb-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:10px}
.ppgb-card{display:flex;align-items:center;gap:10px;border:1px solid var(--border-color,#e5e7eb);border-radius:8px;padding:10px 12px;background:var(--card-bg,#fff);cursor:pointer}
.ppgb-card:hover{box-shadow:0 0 0 1px var(--border-color,#9ca3af)}
.ppgb-card.today{background:#fff6e0;border-color:transparent}
.ppgb-av{width:36px;height:36px;border-radius:50%;flex-shrink:0;object-fit:cover;display:inline-flex;align-items:center;justify-content:center;background:var(--control-bg,#f3f4f6);font-size:12px;font-weight:600;color:var(--text-muted,#6b7280)}
.ppgb-card.today .ppgb-av{background:#fff;color:#8a5a00}
.ppgb-info{flex:1;min-width:0}
.ppgb-name{font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ppgb-pill{font-size:11px;padding:2px 8px;border-radius:6px;background:var(--control-bg,#f3f4f6);color:var(--text-muted,#6b7280);white-space:nowrap}
.ppgb-pill.hot{background:#fff;color:#8a5a00;font-weight:600}
.ppgb-none{padding:14px;border:1px dashed var(--border-color,#d1d5db);border-radius:8px;color:var(--text-muted,#6b7280);text-align:center}
.ppgb-row{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--border-color,#eef0f2);cursor:pointer}
.ppgb-row:last-child{border-bottom:0}
.ppgb-row:hover .ppgb-name{text-decoration:underline}
.ppgb-empty{padding:22px;text-align:center;color:var(--text-muted,#6b7280)}
`;

	const esc = (v) => frappe.utils.escape_html(v == null ? "" : String(v));
	const dateTxt = (s) =>
		new Date(s + "T00:00:00").toLocaleDateString("en-GB", { weekday: "short", day: "2-digit", month: "short" });
	const sub = (p) => [p.department, p.designation].filter(Boolean).join(" · ") || "–";
	const when = (n) => (n === 1 ? "Tomorrow" : "In " + n + " days");

	function injectStyle() {
		if (document.getElementById(STYLE_ID)) return;
		const el = document.createElement("style");
		el.id = STYLE_ID;
		el.textContent = CSS;
		document.head.appendChild(el);
	}

	class PPGBirthdayDashboard {
		constructor($el) {
			injectStyle();
			this.$el = $($el);
			this.data = null;
			this.bind();
		}

		refresh(args = {}) {
			this.$el.html(`<div class="ppgb-empty">Loading birthdays…</div>`);
			return frappe
				.call({ method: METHOD, args })
				.then((r) => {
					this.data = r.message;
					this.render();
				})
				.catch((err) => {
					console.error("Birthday dashboard error:", err);
					this.$el.html(`<div class="ppgb-empty">Could not load birthdays (${esc((err && err.message) || "see console")}).</div>`);
				});
		}

		avatar(p) {
			if (p.image) return `<img class="ppgb-av" src="${esc(p.image)}" alt="">`;
			const initials = (p.employee_name || "?").split(" ").filter(Boolean).slice(0, 2).map((w) => w[0]).join("").toUpperCase();
			return `<span class="ppgb-av">${esc(initials)}</span>`;
		}

		render() {
			const d = this.data;
			if (!d) return;

			const today = d.today.length
				? `<div class="ppgb-grid">${d.today
						.map(
							(p) => `<div class="ppgb-card today" data-emp="${esc(p.name)}">${this.avatar(p)}
								<div class="ppgb-info"><div class="ppgb-name">${esc(p.employee_name)}</div><div class="ppgb-muted">${esc(sub(p))}</div></div>
								<span class="ppgb-pill hot">Today</span></div>`
						)
						.join("")}</div>`
				: `<div class="ppgb-none">No birthdays today</div>`;

			const upcoming = d.upcoming.length
				? d.upcoming
						.map(
							(p) => `<div class="ppgb-row" data-emp="${esc(p.name)}">${this.avatar(p)}
								<div class="ppgb-info"><div class="ppgb-name">${esc(p.employee_name)}</div><div class="ppgb-muted">${esc(sub(p))}</div></div>
								<div style="text-align:right"><div>${esc(dateTxt(p.date))}</div><span class="ppgb-pill">${when(p.in_days)}</span></div></div>`
						)
						.join("")
				: `<div class="ppgb-muted">No birthdays in the next ${d.days} days.</div>`;

			this.$el.html(`
				<div class="ppgb">
					<div class="ppgb-head">
						<div><div class="ppgb-title">Birthdays</div><div class="ppgb-muted">Active employees · as of ${esc(frappe.datetime.str_to_user(d.as_of_date))}</div></div>
						<div class="ppgb-muted">${d.month_count} this month</div>
					</div>
					<div class="ppgb-h">Today</div>${today}
					<div class="ppgb-h">Coming up<span>next ${d.days} days</span></div>${upcoming}
					${d.missing_dob ? `<div class="ppgb-muted" style="margin-top:10px">${d.missing_dob} active employees have no date of birth and are not listed.</div>` : ""}
				</div>`);
		}

		bind() {
			this.$el.off(".ppgb");
			this.$el.on("click.ppgb", "[data-emp]", (e) => frappe.set_route("Form", "Employee", $(e.currentTarget).data("emp")));
		}
	}

	window.PPGBirthdayDashboard = PPGBirthdayDashboard;
})();

/* Glue for management_dashboard.js. Called from render_data(data). */
/* Section key of the HR tab, read from the page's own tab bar. */
function ppgb_hr_section() {
	const $tab = $(".md-tab").filter((_, el) => $(el).text().trim().toLowerCase() === "hr").first();
	return $tab.attr("data-section") || "HR";
}

/* Show the birthday card only while the HR tab is active. Runs after the page's own tab code. */
function ppgb_sync_visibility() {
	const el = document.getElementById("ppgb-root");
	if (!el) return;
	const active = $(".md-tab.active, .md-tab.is-active, .md-tab.selected").first().attr("data-section");
	el.style.setProperty("display", active === ppgb_hr_section() ? "block" : "none", "important");
}

function ppgb_bind_visibility() {
	if (window.ppgb_tab_observer) window.ppgb_tab_observer.disconnect();
	const bar = $(".md-tab").first().parent()[0];
	if (bar) {
		window.ppgb_tab_observer = new MutationObserver(ppgb_sync_visibility);
		window.ppgb_tab_observer.observe(bar, { attributes: true, subtree: true, attributeFilter: ["class"] });
	}
	$(document).off("click.ppgb").on("click.ppgb", ".md-tab", () => setTimeout(ppgb_sync_visibility, 0));
}

/* Keep the birthday card as the last child of its container (bottom of the HR tab). */
function ppgb_keep_last() {
	const el = document.getElementById("ppgb-root");
	if (!el || !el.parentElement) return;
	const parent = el.parentElement;
	const place = () => {
		if (parent.lastElementChild !== el) parent.appendChild(el);
	};
	place();
	if (window.ppgb_order_observer) window.ppgb_order_observer.disconnect();
	let queued = false;
	window.ppgb_order_observer = new MutationObserver(() => {
		if (queued) return;
		queued = true;
		requestAnimationFrame(() => { queued = false; place(); });
	});
	window.ppgb_order_observer.observe(parent, { childList: true });
}

function render_birthday_dashboard(data) {
	try {
		const SECTION = ppgb_hr_section();
		let $root = $("#ppgb-root");
		if (!$root.length) {
			const $cards = $("[data-sections]").filter((_, el) => !/^ppg[dqb]-root$/.test($(el).attr("id") || ""));
			if (!$cards.length) {
				console.warn("PPGB: no [data-sections] cards found on the page.");
				return;
			}
			const inHR = (el) =>
				($(el).attr("data-sections") || "").split(",").map((s) => s.trim()).includes(SECTION);
			let $anchor = $cards.filter((_, el) => inHR(el)).last();
			if (!$anchor.length) $anchor = $cards.last();

			$root = $('<div id="ppgb-root"></div>')
				.addClass($anchor.attr("class") || "md-card section-box")
				.css("grid-column", "1 / -1")
				.insertAfter($anchor);
			window.ppgb_dashboard = new PPGBirthdayDashboard($root);
		}

		$root.attr("data-sections", SECTION);
		ppgb_bind_visibility();
		ppgb_keep_last();
		ppgb_sync_visibility();
		window.ppgb_dashboard.refresh({ as_of_date: data.as_of_date });
	} catch (e) {
		console.error("PPGB: birthday dashboard failed", e);
	}
}



