function filter_dashboard(section) {

    if (section === "All") {

        $(".md-kpi").show();

        $(".section-box").each(function () {

            const sections =
                String($(this).data("sections") || "")
                    .split(",");

            $(this).toggle(
                sections.includes("All")
            );
        });

        // HR-only sections must stay hidden on All tab
        $(".section-box[data-sections='HR']").hide();

        return;
    }


    $(".md-kpi").each(function () {

        $(this).toggle(
            $(this).data("section") === section
        );

    });

    // Sales has its own detailed KPI dashboard.
    if (section === "Sales") {
        $(".md-kpi").hide();
    }


    $(".section-box").each(function () {

        const sections =
            String($(this).data("sections") || "")
                .split(",");

        $(this).toggle(
            sections.includes(section)
        );

    });
}


