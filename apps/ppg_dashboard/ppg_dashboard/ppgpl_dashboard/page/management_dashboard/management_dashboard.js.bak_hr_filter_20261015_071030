
frappe.pages["management-dashboard"].on_page_load = function (wrapper) {
    const roles = (frappe.boot?.user?.roles || []);
    const isHR = (
        roles.includes("HR Manager") ||
        roles.includes("HR User")
    ) && !roles.includes("System Manager");

    document.body.classList.toggle("ppg-hr-dashboard", isHR);

    frappe.ui.make_app_page({
        parent: wrapper,
        title: isHR ? "HR Dashboard" : "Management Dashboard",
        single_column: true
    });

    render_dashboard(wrapper);
};



function apply_hr_dashboard_view() {
    if (!document.body.classList.contains("ppg-hr-dashboard")) return;

    if (!document.getElementById("ppg-hr-dashboard-role-css")) {
        const style = document.createElement("style");
        style.id = "ppg-hr-dashboard-role-css";
        style.textContent = `
            body.ppg-hr-dashboard .md-title {
                font-size: 26px;
            }
            body.ppg-hr-dashboard .md-kpi-grid {
                display: none !important;
            }
            body.ppg-hr-dashboard .md-tab:not([data-section="HR"]) {
                display: none !important;
            }
            body.ppg-hr-dashboard [data-sections] {
                display: none !important;
            }
            body.ppg-hr-dashboard [data-sections="HR"],
            body.ppg-hr-dashboard [data-sections="All,HR"] {
                display: block !important;
            }
        `;
        document.head.appendChild(style);
    }

    const title = document.querySelector(".md-title");
    if (title) title.textContent = "HR Dashboard";

    document.querySelectorAll(".md-tab").forEach(tab => {
        tab.classList.toggle("active", tab.dataset.section === "HR");
    });
}

