			];
			return `
			<div class="ppgd-tabs">${tabs.map(([id, l]) => `<button class="ppgd-tab" data-tab="${id}">${l}</button>`).join("")}</div>
			<div class="ppgd-pane" data-pane="orders">${this.ordersTable(d.orders)}</div>
