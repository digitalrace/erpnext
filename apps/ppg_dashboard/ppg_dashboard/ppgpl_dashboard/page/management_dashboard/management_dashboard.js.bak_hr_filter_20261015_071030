/* Alert banners: red only for a real problem (Finance, Inventory, Purchase) */
(function () {
  function tone() {
    $(".ppgf-alert").each(function () {
      const $a = $(this);
      if ($a.data("ppgf-tone")) return;
      $a.data("ppgf-tone", 1);
      const t = $a.text().trim();
