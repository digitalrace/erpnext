                <td>

                    ${
                        target
                            ? `
                                <span class="sales-target-bar">
                                    <i style="width:${achievement}%"></i>
                                </span>

                                ${Math.round(achievement)}%
                              `
                            : "—"
                    }

                </td>

                <td class="${
                    Number(row.conversion || 0) >= 35
                        ? "sales-green-text"
                        : Number(row.conversion || 0) >= 20
                            ? "sales-warning-text"
                            : "sales-red-text"
                }">

                    ${Number(
                        row.conversion || 0
                    ).toFixed(1)}%

                </td>

            </tr>

        `);

    });

