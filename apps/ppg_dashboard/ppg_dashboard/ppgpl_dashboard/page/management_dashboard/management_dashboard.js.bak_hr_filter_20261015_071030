function render_sales_month_chart(rows) {

    const chart = $("#sales-month-chart");

    chart.empty();

    if (!rows.length) {
        chart.html(`
            <div class="sales-empty-state">
                No monthly sales data.
            </div>
        `);
        return;
    }

    const maxValue = Math.max(
        ...rows.map(function(row) {
            return Math.max(
                Number(row.orders || 0),
                Number(row.revenue || 0)
            );
        }),
        1
    );

    rows.forEach(function(row) {

        const orders = Number(row.orders || 0);
        const revenue = Number(row.revenue || 0);

        const orderHeight = Math.max(
            5,
            (orders / maxValue) * 100
        );

        const revenueHeight = Math.max(
            5,
            (revenue / maxValue) * 100
        );

        chart.append(`
            <div
                class="sales-month-column"
                data-month="${sales_escape(row.label)}"
                data-orders="${orders}"
                data-revenue="${revenue}"
            >

                <div class="sales-month-bars">

                    <div
                        class="sales-bar orders"
                        style="height:${orderHeight}%"
                    ></div>

                    <div
                        class="sales-bar revenue"
                        style="height:${revenueHeight}%"
                    ></div>

                </div>

                <span>
                    ${sales_escape(row.label)}
                </span>

                <div class="sales-month-value-popup">
                    <strong>${sales_escape(row.label)}</strong>
                    <div>
                        Orders booked:
                        <b>${sales_money(orders)}</b>
                    </div>
                    <div>
                        Invoiced:
                        <b>${sales_money(revenue)}</b>
                    </div>
                </div>

            </div>
        `);

    });
}


