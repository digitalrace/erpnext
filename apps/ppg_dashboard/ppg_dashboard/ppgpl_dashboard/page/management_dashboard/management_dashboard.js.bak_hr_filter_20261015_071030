		}

		qaStations(d) {
			if (!d.qa_stations.length) return "";
			const cards = d.qa_stations
				.map(
					(w) => `<div class="ppgq-qa" ${goA("Job Card", { workstation: w.workstation, status: ["in", OPEN_JOB], docstatus: ["<", 2] })}>
