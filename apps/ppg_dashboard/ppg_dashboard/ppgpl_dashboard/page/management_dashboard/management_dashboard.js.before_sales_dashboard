    justify-content: space-between;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 15px;
}

.md-card-header h4 {
    margin: 0;
    font-size: 15px;
    font-weight: 650;
    color: #1d2737;
}

.md-card-header span {
