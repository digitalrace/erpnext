}

.attention-row.danger {
    border-left-color: #dc2626;
}

.attention-row.warning {
    border-left-color: #f59e0b;
}

.attention-row strong {
    font-weight: 550;
}

.alert-number {
    font-weight: 700;
    color: #5b6574;
}

.empty-state,
