    width: 100%;
    display: flex;
    align-items: end;
    justify-content: center;
    gap: 4px;
}

.chart-bar {
    width: 14px;
    min-height: 2px;
    border-radius: 3px 3px 0 0;
}

.chart-bar.revenue {
    background: #3478d4;
}

.chart-bar.expense {
    background: #ef6b35;
}

.chart-month {
    color: #7b8494;
    font-size: 10px;
}

.chart-legend {
