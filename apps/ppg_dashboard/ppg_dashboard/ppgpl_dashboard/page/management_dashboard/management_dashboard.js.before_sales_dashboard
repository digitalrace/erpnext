            row.employee || "";

        const employee_name =
            row.employee_name ||
            employee ||
            "Unknown Employee";

        const department =
            row.department ||
            "";

        const initial =
            employee_name
                .charAt(0)
                .toUpperCase();


        list.append(`
            <div
                class="hr-absent-row"
                data-employee="${frappe.utils.escape_html(employee)}">

                <div class="hr-avatar">
                    ${frappe.utils.escape_html(initial)}
                </div>

                <div class="hr-employee-info">

                    <strong>
                        ${frappe.utils.escape_html(employee_name)}
                    </strong>

                    <span>
                        ${frappe.utils.escape_html(employee)}

                        ${
                            department
                                ? " · " +
                                  frappe.utils.escape_html(department)
                                : ""
                        }
                    </span>

                </div>

                <div class="hr-absent-status">
                    <span class="hr-status-dot red"></span>
                    Absent
                </div>

            </div>
        `);

    });


    list.find(".hr-absent-row")
        .off("click")
        .on("click", function() {

            const employee =
                $(this).data("employee");

            if (employee) {

                frappe.set_route(
                    "Form",
                    "Employee",
                    employee
                );

            }

        });

}


