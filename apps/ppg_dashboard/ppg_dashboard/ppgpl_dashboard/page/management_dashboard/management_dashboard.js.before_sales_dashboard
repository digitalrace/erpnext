    grid-template-columns: repeat(4, 1fr);
    gap: 9px;
}

.summary-stat {
    background: #fafbfc;
    border: 1px solid #edf0f3;
    border-radius: 8px;
    padding: 11px 12px;
}

.summary-stat span {
    display: block;
    color: #737e8d;
    font-size: 10px;
}

.summary-stat strong {
    display: block;
    margin-top: 6px;
    color: #172033;
    font-size: 18px;
    font-weight: 700;
}

.progress-row {
    display: flex;
    justify-content: space-between;
    margin-top: 16px;
    color: #737e8d;
    font-size: 11px;
}

.progress-track {
    height: 8px;
    background: #eef1f4;
    border-radius: 20px;
    overflow: hidden;
    margin-top: 7px;
}

.progress-value {
    width: 0;
    height: 100%;
    background: #3478d4;
    border-radius: 20px;
