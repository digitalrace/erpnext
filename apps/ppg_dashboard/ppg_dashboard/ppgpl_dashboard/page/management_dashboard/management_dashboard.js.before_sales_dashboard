    border: 1px solid #d9dee7;
    border-radius: 7px;
    padding: 8px 12px;
    font-size: 11px;
    color: #475569;
    cursor: pointer;
}

.quick-btn:hover {
    background: #f7faff;
    border-color: #9ebcf4;
}

@media (max-width: 1200px) {

    .md-kpi-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .summary-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .business-flow {
        display: flex;
        overflow-x: auto;
        justify-content: flex-start;
        padding-bottom: 8px;
    }

    .flow-item {
        min-width: 110px;
    }

    .flow-arrow {
        min-width: 28px;
    }
}

@media (max-width: 800px) {

    .management-dashboard {
        padding: 14px;
    }

    .md-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .md-actions {
        width: 100%;
        flex-wrap: wrap;
    }

    .md-two-column {
        grid-template-columns: 1fr;
    }

    .md-kpi-grid {
        grid-template-columns: 1fr 1fr;
    }
}

@media (max-width: 550px) {

    .md-kpi-grid {
        grid-template-columns: 1fr;
    }

    .summary-grid {
        grid-template-columns: 1fr 1fr;
    }
}

