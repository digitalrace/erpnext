function render_financial_chart(rows) {

    const container = $("#financial-chart");

    container.empty();


    if (!rows.length) {
        return;
    }


    const maxValue = Math.max(
        1,
        ...rows.flatMap(row => [
            Number(row.revenue || 0),
            Number(row.expense || 0)
        ])
    );


    rows.forEach(function (row) {

        const revenueHeight =
            (Number(row.revenue || 0) / maxValue) * 100;

        const expenseHeight =
            (Number(row.expense || 0) / maxValue) * 100;


        container.append(`
            <div class="chart-column">

                <div class="chart-bars">

                    <div class="chart-bar revenue"
                         style="height:${Math.max(revenueHeight, 2)}%">
                    </div>

                    <div class="chart-bar expense"
                         style="height:${Math.max(expenseHeight, 2)}%">
                    </div>

                </div>

                <div class="chart-month">
                    ${frappe.utils.escape_html(row.label)}
                </div>

            </div>
        `);

    });
}


