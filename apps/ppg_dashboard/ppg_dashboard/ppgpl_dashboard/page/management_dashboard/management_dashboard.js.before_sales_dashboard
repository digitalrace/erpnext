    height: 9px;
    display: inline-block;
    border-radius: 2px;
    margin-right: 4px;
}

.legend.revenue {
    background: #3478d4;
}

.legend.expense {
    background: #ef6b35;
}

.quick-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.quick-btn {
