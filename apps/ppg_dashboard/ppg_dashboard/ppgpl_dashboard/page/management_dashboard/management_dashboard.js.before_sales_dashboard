
frappe.pages["management-dashboard"].on_page_load = function (wrapper) {

    frappe.ui.make_app_page({
        parent: wrapper,
        title: "Management Dashboard",
        single_column: true
    });

    render_dashboard(wrapper);
};


function render_dashboard(wrapper) {

    if (!document.getElementById("management-dashboard-inline-css")) {

        const style = document.createElement("style");

        style.id = "management-dashboard-inline-css";

        style.innerHTML = `
