    border-radius: 8px;
    padding: 7px 14px;
    font-size: 12px;
    cursor: pointer;
    transition: all 0.15s ease;
}

.md-tab:hover {
    border-color: #9ebcf4;
}

.md-tab.active {
    background: #edf4ff;
    color: #1758bb;
    border-color: #8fb7fa;
    font-weight: 600;
}

.md-kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 15px;
}

.md-kpi {
    background: #fff;
    border: 1px solid #e0e5ec;
    border-radius: 10px;
    padding: 15px 16px;
    min-height: 104px;
    transition: transform 0.12s ease,
                box-shadow 0.12s ease;
}

.md-kpi.clickable-kpi {
    cursor: pointer;
}

.md-kpi.clickable-kpi:hover {
