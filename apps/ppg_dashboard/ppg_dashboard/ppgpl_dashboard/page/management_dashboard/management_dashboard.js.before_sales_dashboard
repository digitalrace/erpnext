    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 18px;
}

.md-title {
    font-size: 25px;
    font-weight: 700;
    letter-spacing: -0.3px;
}

.md-subtitle {
    margin-top: 4px;
    color: #7b8494;
    font-size: 12px;
}

.md-updated {
    color: #98a1af;
}

.md-actions {
    display: flex;
    align-items: flex-end;
    gap: 8px;
}

.md-actions > div {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.md-actions label {
    font-size: 10px;
    color: #7b8494;
    margin: 0;
}

.md-actions input {
    width: 145px;
}

.md-actions select {
    width: 88px;
}

.md-refresh {
    height: 36px;
    padding: 0 14px;
}

.md-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 16px;
}

