}

.clickable-row:hover td {
    background: #f7faff;
}

.reason-badge {
    display: inline-block;
    border-radius: 5px;
    background: #fff4e5;
    color: #a85c00;
    padding: 3px 7px;
    font-size: 10px;
}

.service-detail-grid {
    margin-top: 6px;
}

.service-response-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.service-big-stat {
    background: #fafbfc;
    border: 1px solid #edf0f3;
    border-radius: 8px;
    padding: 15px;
}

.service-big-stat span {
    display: block;
    color: #737e8d;
    font-size: 10px;
}

.service-big-stat strong {
    display: block;
    margin-top: 6px;
    font-size: 22px;
    color: #172033;
}

.financial-chart {
    height: 185px;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 8px;
    border-bottom: 1px solid #e8ebef;
    padding: 8px 8px 0;
}

.chart-column {
    height: 100%;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: end;
    align-items: center;
    gap: 5px;
}

.chart-bars {
