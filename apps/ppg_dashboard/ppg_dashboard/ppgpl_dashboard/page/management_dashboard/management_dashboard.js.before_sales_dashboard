    margin-top: 3px;
    color: #8a94a4;
    font-size: 10px;
}

.md-two-column {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

.business-flow {
    display: grid;
    grid-template-columns:
