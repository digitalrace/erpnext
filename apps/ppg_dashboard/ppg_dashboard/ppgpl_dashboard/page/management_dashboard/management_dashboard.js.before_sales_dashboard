.flow-item {
    text-align: center;
}

.flow-number {
    font-size: 23px;
    font-weight: 700;
    color: #172033;
}

.flow-label {
    margin-top: 5px;
    font-size: 10px;
    color: #707b8a;
}

.flow-arrow {
    text-align: center;
    font-size: 18px;
    color: #aab3bf;
}

.attention-list {
    display: flex;
    flex-direction: column;
}

.attention-row {
