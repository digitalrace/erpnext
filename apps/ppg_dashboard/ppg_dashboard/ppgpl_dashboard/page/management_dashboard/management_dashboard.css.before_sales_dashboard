.management-dashboard {
    background: #f7f8fa;
    min-height: calc(100vh - 60px);
    padding: 22px 26px 40px;
    color: #172033;
}

.md-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 18px;
}

.md-title {
    font-size: 25px;
    font-weight: 700;
}

.md-subtitle {
    margin-top: 4px;
    color: #7b8494;
    font-size: 12px;
}

.md-actions {
    display: flex;
    align-items: flex-end;
    gap: 8px;
}

.md-actions > div {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.md-actions label {
    font-size: 10px;
    color: #7b8494;
    margin: 0;
}

.md-actions input {
    width: 145px;
}

.md-actions select {
    width: 88px;
}

.md-refresh {
    height: 36px;
}

.md-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 16px;
}

.md-tab {
    border: 1px solid #d9dee7;
    background: #fff;
    color: #536070;
    border-radius: 8px;
    padding: 7px 14px;
    font-size: 12px;
    cursor: pointer;
}

.md-tab.active {
    background: #edf4ff;
    color: #1758bb;
    border-color: #8fb7fa;
    font-weight: 600;
}

.md-kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 15px;
}

.md-kpi {
    background: #fff;
    border: 1px solid #e0e5ec;
    border-radius: 10px;
    padding: 15px 16px;
    min-height: 104px;
}

.kpi-label {
    color: #697386;
    font-size: 11px;
}

.kpi-value {
    margin-top: 7px;
    font-size: 24px;
    font-weight: 700;
    color: #111827;
}

.kpi-sub {
    margin-top: 7px;
    font-size: 11px;
    color: #7b8494;
}

.md-card {
    background: #fff;
    border: 1px solid #e0e5ec;
    border-radius: 10px;
    padding: 17px;
    margin-bottom: 15px;
}

.md-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 15px;
}

.md-card-header h4 {
    margin: 0;
    font-size: 15px;
    font-weight: 650;
}

.md-card-header span {
    display: block;
    margin-top: 3px;
    color: #8a94a4;
    font-size: 10px;
}

.md-two-column {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

.summary-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
}

.summary-stat {
    background: #fafbfc;
    border: 1px solid #edf0f3;
    border-radius: 8px;
    padding: 12px;
}

.summary-stat span {
    display: block;
    color: #737e8d;
    font-size: 10px;
}

.summary-stat strong {
    display: block;
    margin-top: 6px;
    font-size: 18px;
}

.clickable-summary {
    cursor: pointer;
}

.clickable-summary:hover {
    background: #f7faff;
    border-color: #a8c5f5;
}

.business-flow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    overflow-x: auto;
    gap: 10px;
    padding: 8px 0;
}

.flow-item {
    min-width: 100px;
    text-align: center;
}

.flow-number {
    font-size: 23px;
    font-weight: 700;
}

.flow-label {
    margin-top: 5px;
    color: #707b8a;
    font-size: 10px;
}

.flow-arrow {
    color: #aab3bf;
    font-size: 18px;
}

.progress-row {
    display: flex;
    justify-content: space-between;
    margin-top: 15px;
    color: #737e8d;
    font-size: 11px;
}

.progress-track {
    height: 8px;
    background: #eef1f4;
    border-radius: 20px;
    overflow: hidden;
    margin-top: 7px;
}

.progress-value {
    width: 0;
    height: 100%;
    background: #3478d4;
    border-radius: 20px;
}

.md-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 11px;
}

.md-table th {
    padding: 8px;
    text-align: left;
    color: #7a8493;
    border-bottom: 1px solid #dfe4ea;
}

.md-table td {
    padding: 9px 8px;
    border-bottom: 1px solid #edf0f3;
}

.clickable-row {
    cursor: pointer;
}

.clickable-row:hover td {
    background: #f7faff;
}

/* HR */

.hr-kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
}

.hr-kpi-grid .summary-stat {
    min-height: 95px;
}

.hr-card-present {
    background: #f0fdf4 !important;
    border-left: 4px solid #16a34a !important;
}

.hr-card-present strong {
    color: #15803d;
}

.hr-card-absent {
    background: #fef2f2 !important;
    border-left: 4px solid #dc2626 !important;
}

.hr-card-absent strong {
    color: #dc2626;
}

.hr-card-leave {
    background: #fffbeb !important;
    border-left: 4px solid #f59e0b !important;
}

.hr-card-leave strong {
    color: #b45309;
}

.hr-card-half {
    background: #eff6ff !important;
    border-left: 4px solid #3b82f6 !important;
}

.hr-card-half strong {
    color: #2563eb;
}

.hr-card-attendance {
    background: #f5f3ff !important;
    border-left: 4px solid #7c3aed !important;
}

.hr-card-attendance strong {
    color: #6d28d9;
}

.hr-card-pending {
    background: #fff7ed !important;
    border-left: 4px solid #f97316 !important;
}

.hr-card-pending strong {
    color: #ea580c;
}

.hr-source-info {
    display: flex;
    gap: 28px;
    margin-top: 12px;
    padding: 10px 12px;
    background: #f8fafc;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
}

.hr-source-info div {
    display: flex;
    gap: 7px;
    align-items: center;
}

.hr-source-info span {
    color: #7b8494;
    font-size: 10px;
}

.hr-source-info strong {
    font-size: 10px;
}

.hr-absent-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
}

.hr-absent-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px;
    background: #fffafa;
    border: 1px solid #f2dada;
    border-left: 3px solid #dc2626;
    border-radius: 8px;
    cursor: pointer;
}

.hr-absent-row:hover {
    background: #fff1f1;
}

.hr-avatar {
    width: 32px;
    height: 32px;
    min-width: 32px;
    border-radius: 50%;
    background: #fee2e2;
    color: #b91c1c;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
}

.hr-employee-info {
    min-width: 0;
    flex: 1;
}

.hr-employee-info strong {
    display: block;
    font-size: 11px;
}

.hr-employee-info span {
    display: block;
    margin-top: 2px;
    color: #8b95a3;
    font-size: 9px;
}

.hr-absent-status {
    color: #b91c1c;
    font-size: 9px;
    font-weight: 650;
}

.hr-empty {
    padding: 25px;
    text-align: center;
    color: #8b95a3;
    font-size: 11px;
}

.hr-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
}

.hr-status-dot.red {
    background: #dc2626;
}

.hr-status-dot.green {
    background: #16a34a;
}

@media (max-width: 1000px) {
    .md-kpi-grid,
    .hr-kpi-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .md-two-column {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 600px) {
    .md-kpi-grid,
    .hr-kpi-grid {
        grid-template-columns: 1fr;
    }

    .hr-absent-list {
        grid-template-columns: 1fr;
    }
}

/* HR compact management layout */
.hr-kpi-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    gap: 10px !important;
}

.hr-kpi-grid .summary-stat {
    min-height: 88px !important;
    padding: 11px !important;
}

.hr-absent-list {
    grid-template-columns: 1fr !important;
    max-height: 330px;
    overflow-y: auto;
}

.hr-absent-row {
    padding: 8px 10px !important;
}

@media (min-width: 1100px) {
    .section-box[data-sections="HR"] + .section-box[data-sections="HR"] {
        width: 50%;
    }
}


@media (min-width: 1100px) {
    .hr-absent-section {
        width: 50%;
    }
}

@media (max-width: 1099px) {
    .hr-absent-section {
        width: 100%;
    }
}
