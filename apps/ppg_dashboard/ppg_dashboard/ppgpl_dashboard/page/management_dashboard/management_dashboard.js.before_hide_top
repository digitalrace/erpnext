    .md-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .md-actions {
        width: 100%;
        flex-wrap: wrap;
    }

    .md-two-column {
        grid-template-columns: 1fr;
    }

    .md-kpi-grid {
        grid-template-columns: 1fr 1fr;
    }
}

@media (max-width: 550px) {

    .md-kpi-grid {
        grid-template-columns: 1fr;
    }

    .summary-grid {
        grid-template-columns: 1fr 1fr;
    }
}

