function load_sales_dashboard(as_of_date, period, custom_from_date = null, custom_to_date = null) {

    frappe.call({

        method: "ppg_dashboard.api.management_dashboard.get_sales_dashboard",

        args: {
            as_of_date: as_of_date,
            period: period,
                custom_from_date: custom_from_date || null,
                custom_to_date: custom_to_date || null
        },

        callback: function(r) {

            if (!r || !r.message) {
                console.error("Sales dashboard data not returned");
                return;
            }

            render_sales_dashboard(r.message);
        },

        error: function(r) {
            console.error(
                "Sales dashboard error:",
                r
            );
        }

    });
}


function sales_money(value) {

    return format_currency(
        Number(value || 0)
    );

}


function sales_escape(value) {

    return frappe.utils.escape_html(
        String(value ?? "")
    );

}


