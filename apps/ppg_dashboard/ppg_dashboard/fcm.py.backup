import json

import frappe
import firebase_admin

from firebase_admin import credentials, messaging


FIREBASE_CREDENTIALS = (
    "/home/frappe/firebase/firebase-service-account.json"
)


# ============================================================
# FIREBASE
# ============================================================

def get_firebase_app():

    try:
        return firebase_admin.get_app()

    except ValueError:

        cred = credentials.Certificate(
            FIREBASE_CREDENTIALS
        )

        return firebase_admin.initialize_app(
            cred
        )


# ============================================================
# DEVICE TOKEN REGISTRATION
# ============================================================

@frappe.whitelist()
def register_fcm_token(
    token,
    device_type="Web",
    device_id=None
):

    if not token:
        frappe.throw(
            "FCM token is required."
        )

    allowed_types = {
        "Android",
        "iOS",
        "Web",
        "PWA"
    }

    if device_type not in allowed_types:
        frappe.throw(
            "Invalid device type."
        )

    user = frappe.session.user

    if not user or user == "Guest":
        frappe.throw(
            "Login is required."
        )

    filters = {
        "user": user,
        "fcm_token": token
    }

    existing_name = frappe.db.exists(
        "FCM Device Token",
        filters
    )

    if existing_name:

        doc = frappe.get_doc(
            "FCM Device Token",
            existing_name
        )

        doc.device_type = device_type
        doc.device_id = device_id
        doc.active = 1
        doc.save(
            ignore_permissions=True
        )

    else:

        doc = frappe.get_doc({
            "doctype":
                "FCM Device Token",

            "user":
                user,

            "fcm_token":
                token,

            "device_type":
                device_type,

            "device_id":
                device_id,

            "active":
                1
        })

        doc.insert(
            ignore_permissions=True
        )

    frappe.db.commit()

    return {
        "success": True,
        "message":
            "FCM token registered successfully."
    }


# ============================================================
# GET USER TOKENS
# ============================================================

def get_user_tokens(user):

    return frappe.get_all(
        "FCM Device Token",

        filters={
            "user": user,
            "active": 1
        },

        fields=[
            "name",
            "fcm_token",
            "device_type",
            "device_id"
        ]
    )


