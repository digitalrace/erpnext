(function () {
    function showHRButton() {
        if (!window.frappe || !frappe.user || !frappe.get_route_str) return;

        const roles = frappe.user.get_roles();
        const isHR = (
            roles.includes("HR Manager") ||
            roles.includes("HR User")
        ) && !roles.includes("System Manager");

        const route = (frappe.get_route_str() || "").toLowerCase();
        const onDeskHome = route === "" || route === "desk" || route.startsWith("workspace");

        if (!isHR || !onDeskHome) {
            $("#custom-hr-btn").remove();
            return;
        }

        if (!$("#custom-hr-btn").length) {
            const button = $(`
                <div id="custom-hr-btn" style="margin:20px 0;">
                    <button class="btn btn-primary">Open HR Dashboard</button>
                </div>
            `);
            button.find("button").on("click", function () {
                frappe.set_route("management-dashboard");
            });

            if ($(".workspace-container").length) {
                $(".workspace-container").prepend(button);
            } else if ($(".page-head").length) {
                $(".page-head").after(button);
            }
        }
    }

    $(document).ready(function () {
        if (window.frappe && frappe.router) {
            frappe.router.on("change", function () {
                setTimeout(showHRButton, 500);
            });
        }
        setTimeout(showHRButton, 1000);
    });
})();
