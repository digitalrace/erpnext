(function () {
    function show_hr_button() {
        if (!window.frappe || !frappe.user || !frappe.get_route_str) return;

        const roles = frappe.user.get_roles();
        const is_hr = (
            roles.includes("HR Manager") ||
            roles.includes("HR User")
        ) && !roles.includes("System Manager");

        const route = (frappe.get_route_str() || "").toLowerCase();

        if (is_hr && (route === "" || route.includes("workspace"))) {
            if (!$("#custom-hr-btn").length) {
                const btn = `
                    <div id="custom-hr-btn" style="text-align:center;margin:20px 0;">
                        <button class="btn btn-primary"
                            onclick="frappe.set_route(management-dashboard)">
                            Open HR Dashboard
                        </button>
                    </div>`;
                if ($(".workspace-container").length) {
                    $(".workspace-container").prepend(btn);
                } else if ($(".page-head").length) {
                    $(".page-head").after(btn);
                }
            }
        } else {
            $("#custom-hr-btn").remove();
        }
    }

    $(document).ready(function () {
        frappe.router.on("change", () => setTimeout(show_hr_button, 500));
        setTimeout(show_hr_button, 1000);
    });
})();
