{% extends "templates/web.html" %}
{% block title %}Order Tracking | Power Partner Global{% endblock %}
{% block page_content %}
<style>
body:has(.ppg-industrial-track){background:#f2f6ef!important;overflow-x:hidden}
body:has(.ppg-industrial-track) .navbar,
body:has(.ppg-industrial-track) header.navbar,
body:has(.ppg-industrial-track) .web-header,
body:has(.ppg-industrial-track) .web-footer,
body:has(.ppg-industrial-track) footer:not(.ppg-industrial-footer):not(.ppg-i-footer){display:none!important}
body:has(.ppg-industrial-track) .page-content,
body:has(.ppg-industrial-track) .page-content-wrapper,
body:has(.ppg-industrial-track) .web-page-content,
body:has(.ppg-industrial-track) .main-section,
body:has(.ppg-industrial-track) .container{max-width:none!important}
body:has(.ppg-industrial-track) .page-content,
body:has(.ppg-industrial-track) .page-content-wrapper,
body:has(.ppg-industrial-track) .web-page-content{padding:0!important;margin:0!important}
.ppg-industrial-track,.ppg-industrial-track *{box-sizing:border-box}
.ppg-industrial-track{
 --forest:#103c30;--green:#216547;--lime:#d8f28a;
 --line:#e2eade;--muted:#7c887f;
 position:relative;left:calc(50% - 50vw);width:100vw;max-width:100vw;
 margin:0;background:#f2f6ef;color:#20362a;font-family:inherit;
 font-size:13px;overflow:hidden;
}
.ppg-i-container{width:100%;max-width:1580px;margin:0 auto;padding:0 34px}
.ppg-i-header{height:58px;background:white;border-bottom:1px solid #e6ebe3}
.ppg-i-header-inner{height:100%;display:flex;align-items:center;gap:28px}
.ppg-i-brand{display:flex;align-items:center;gap:10px;min-width:270px}
.ppg-i-logo{width:38px;height:38px;display:grid;place-items:center;border-radius:50%;border:3px solid #78aa5c;background:#eef5e7;color:#1d5b3e;font-size:12px;font-weight:950}
.ppg-i-brand strong{display:block;color:#173c2c;font-size:13px;font-weight:950;letter-spacing:.45px}
.ppg-i-brand small{display:block;color:#819085;font-size:8px;letter-spacing:1.5px;margin-top:3px}
.ppg-i-nav{height:36px;display:flex;align-items:center;gap:9px;border-bottom:2px solid #2e6c49;color:#294737;font-size:10px;font-weight:900;letter-spacing:.8px;white-space:nowrap}
.ppg-i-nav svg{width:18px;height:18px}
.ppg-i-header-right{margin-left:auto;display:flex;align-items:center;gap:12px}
.ppg-i-help-icon{display:grid;place-items:center;color:#245a40}
.ppg-i-help-icon svg{width:22px;height:22px}
.ppg-i-help{color:#65736a;font-size:10px;line-height:1.6}
.ppg-i-help strong{display:block;color:#254331}
.ppg-i-contact{padding:11px 16px;border:0;border-radius:8px;background:var(--lime);color:#263f2b!important;text-decoration:none!important;font-size:10px;font-weight:900;white-space:nowrap}
.ppg-i-cover{
 color:white;
 background-color:#103c30;
 background-image:linear-gradient(90deg,rgba(7,44,33,.98) 0%,rgba(8,51,38,.93) 43%,rgba(8,47,36,.65) 100%),url("https://www.lwe-engineering.com/wp-content/uploads/2021/02/about_lwe_5.jpg");
 background-size:cover;background-position:center 48%;
}
.ppg-i-cover-inner{display:grid;grid-template-columns:minmax(0,1fr) 290px;align-items:center;gap:30px;min-height:177px;padding-top:24px;padding-bottom:24px}
.ppg-i-kicker{color:#d8f28a;font-size:10px;font-weight:950;letter-spacing:1.5px}
.ppg-i-cover h1{margin:11px 0 9px;color:white!important;font-size:clamp(31px,3.15vw,45px);line-height:1.1;letter-spacing:-1.2px;font-weight:900}
.ppg-i-cover h1 span{color:#d8f28a}
.ppg-i-cover p{max-width:680px;margin:0;color:#e0ebe3;font-size:12px;line-height:1.7}
.ppg-i-token{width:100%;padding:17px 18px;border:1px solid #c7e0c655;border-radius:14px;background:#123f31e8;box-shadow:0 12px 30px #0002}
.ppg-i-token label{display:block;color:#c5ddce;font-size:9px;font-weight:900;letter-spacing:1.2px}
.ppg-i-token-row{display:flex;align-items:center;gap:7px;margin-top:8px}
.ppg-i-token-row strong{flex:1;color:#fff;font-size:14px;overflow-wrap:anywhere}
.ppg-i-copy{border:0;border-radius:6px;background:#d8f28a;padding:7px 9px;color:#24412d;font-size:9px;font-weight:900;cursor:pointer}
.ppg-i-token-note{margin-top:7px;color:#c5dacb;font-size:9px}
.ppg-i-content{position:relative}
.ppg-i-order-strip{position:relative;z-index:2;display:grid;grid-template-columns:minmax(230px,1.6fr) repeat(5,minmax(105px,1fr));align-items:center;gap:0;padding:15px 16px;margin-top:-1px;border:1px solid var(--line);border-radius:0 0 13px 13px;background:white;box-shadow:0 8px 22px #183e2610}
.ppg-i-product{display:flex;align-items:center;gap:12px;min-width:0;padding-right:14px}
.ppg-i-product-img,.ppg-i-product-fallback{width:66px;height:60px;flex:0 0 66px;object-fit:cover;border-radius:8px;background:#edf3e8}
.ppg-i-product-fallback{display:grid;place-items:center;color:#50764d;font-size:11px;font-weight:950}
.ppg-i-label{display:block;margin-bottom:5px;color:#7f8a80;font-size:9px;font-weight:950;letter-spacing:.65px}
.ppg-i-product-name{display:block;color:#183b2d;font-size:13px;line-height:1.4;font-weight:900;overflow-wrap:anywhere}
.ppg-i-product-code{display:block;margin-top:4px;color:#819084;font-size:9px;line-height:1.5;overflow-wrap:anywhere}
.ppg-i-metric{display:flex;align-items:center;gap:8px;min-width:0;padding:7px 9px;border-left:1px solid #edf0eb}
.ppg-i-metric-icon{width:30px;height:30px;flex:0 0 30px;border-radius:9px;background:#edf4e7;color:#36704b;display:grid;place-items:center}
.ppg-i-metric-icon svg{width:16px;height:16px}
.ppg-i-metric label{display:block;color:#899389;font-size:9px;line-height:1.45}
.ppg-i-metric strong{display:block;margin-top:4px;color:#244331;font-size:11px;line-height:1.5;overflow-wrap:anywhere}
.ppg-i-status-badge{display:inline-block;padding:5px 7px;border-radius:5px;background:#e6f3ae;color:#3e5723;font-size:9px;font-weight:950}
.ppg-i-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:12px}
.ppg-i-stat{padding:14px 17px;border:1px solid var(--line);border-radius:11px;background:white;min-width:0}
.ppg-i-stat label{display:block;color:#829085;font-size:9px;font-weight:950;letter-spacing:.7px}
.ppg-i-stat strong{display:block;margin-top:7px;color:#214b35;font-size:16px;line-height:1.5;overflow-wrap:anywhere}
.ppg-i-stat small{display:block;margin-top:4px;color:#859188;font-size:10px;line-height:1.5}
.ppg-i-main-grid{display:grid;grid-template-columns:minmax(0,1.48fr) minmax(345px,.94fr);gap:14px;margin-top:13px;align-items:start}
.ppg-i-col{display:flex;flex-direction:column;gap:13px;min-width:0}
.ppg-i-panel{padding:17px;border:1px solid var(--line);border-radius:13px;background:white;min-width:0}
.ppg-i-panel-head{display:flex;align-items:center;gap:10px;margin-bottom:16px}
.ppg-i-panel-icon{width:36px;height:36px;flex:0 0 36px;border-radius:10px;background:#eaf3e3;color:#32734b;display:grid;place-items:center}
.ppg-i-panel-icon svg{width:18px;height:18px}
.ppg-i-panel-head h2{margin:0;color:#203b2d;font-size:12px;line-height:1.4;font-weight:950;letter-spacing:.35px}
.ppg-i-panel-head p{margin:4px 0 0;color:#819086;font-size:10px;line-height:1.5}
.ppg-i-head-right{margin-left:auto;color:#7c8c80;font-size:9px;white-space:nowrap}
.ppg-i-live-dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:#33a269;margin-right:5px}
.ppg-i-production{display:grid;grid-template-columns:minmax(0,1.18fr) minmax(0,.98fr);gap:16px}
.ppg-i-job-photo,.ppg-i-photo-placeholder{width:100%;height:235px;display:block;object-fit:cover;border-radius:9px;background:#e9efe3}
.ppg-i-photo-placeholder{position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-end;align-items:flex-start;gap:8px;padding:17px;border:1px solid #d4e0cd;color:white;background:linear-gradient(0deg,#092f25df,transparent 75%),url("https://images.unsplash.com/photo-1567789884554-0b844b597180?auto=format&fit=crop&w=900&q=80") center/cover}
.ppg-i-photo-tag{padding:7px 10px;border-radius:6px;background:#d8f28a;color:#38522c;font-size:9px;font-weight:950;letter-spacing:.6px}
.ppg-i-photo-caption{margin-top:7px;color:#89958b;font-size:9px;line-height:1.5}
.ppg-i-op-label{color:#849087;font-size:9px;font-weight:950;letter-spacing:1px}
.ppg-i-operation-name{margin:8px 0 9px;color:#1b5238;font-size:23px;line-height:1.2;font-weight:950;overflow-wrap:anywhere}
.ppg-i-chip{display:inline-block;padding:6px 8px;border-radius:5px;background:#e8f3b5;color:#495d25;font-size:9px;font-weight:950}
.ppg-i-machines{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:12px}
.ppg-i-machine{display:flex;align-items:center;gap:7px;padding:8px;border:1px solid #e4ece0;border-radius:8px;min-width:0}
.ppg-i-machine-icon{display:grid;place-items:center;width:29px;height:29px;flex:0 0 29px;background:#edf4e7;border-radius:8px;color:#3b704a}
.ppg-i-machine-icon svg{width:15px;height:15px}
.ppg-i-machine small{display:block;color:#89938a;font-size:8px}
.ppg-i-machine strong{display:block;margin-top:3px;color:#365241;font-size:10px;line-height:1.4;overflow-wrap:anywhere}
.ppg-i-progress-head{display:flex;justify-content:space-between;align-items:end;gap:8px;margin-top:17px}
.ppg-i-progress-head span{color:#526a5a;font-size:10px;font-weight:850}
.ppg-i-progress-head strong{color:#1e6641;font-size:23px;font-weight:950}
.ppg-i-progress{height:8px;margin-top:7px;border-radius:9px;overflow:hidden;background:#e5ece1}
.ppg-i-progress-fill{height:100%;background:linear-gradient(90deg,#176744,#72b76b);border-radius:9px}
.ppg-i-divider{border:0;border-top:1px solid #e9eee5;margin:17px 0}
.ppg-i-section-label{margin-bottom:6px;color:#53695a;font-size:9px;font-weight:950;letter-spacing:.65px}
.ppg-i-operations{display:flex;flex-direction:column}
.ppg-i-operation-row{display:grid;grid-template-columns:9px minmax(0,1fr) auto;align-items:center;gap:9px;padding:9px 0;border-bottom:1px solid #eff2ec}
.ppg-i-operation-row:last-child{border-bottom:0}
.ppg-i-op-dot{width:8px;height:8px;border-radius:50%;background:#cad4c7}
.ppg-i-op-dot.completed{background:#2d8a58}
.ppg-i-op-dot.active{background:#d0a340;box-shadow:0 0 0 3px #fbf1d5}
.ppg-i-operation-row strong{display:block;color:#405648;font-size:10px}
.ppg-i-operation-row small{display:block;color:#89948a;font-size:9px;margin-top:3px}
.ppg-i-op-state{color:#829085;font-size:9px;white-space:nowrap}
.ppg-i-timeline{display:flex;flex-direction:column}
.ppg-i-stage{position:relative;display:grid;grid-template-columns:29px minmax(0,1fr) auto;gap:9px;align-items:start;padding-bottom:18px}
.ppg-i-stage:last-child{padding-bottom:0}
.ppg-i-stage:not(:last-child):before{content:"";position:absolute;left:13px;top:28px;bottom:0;width:2px;background:#e1e9dd}
.ppg-i-stage-icon{position:relative;z-index:1;display:grid;place-items:center;width:28px;height:28px;border:1px solid #e0e7dc;border-radius:50%;background:#f2f6ef;color:#849184}
.ppg-i-stage-icon svg{width:14px;height:14px}
.ppg-i-stage.completed .ppg-i-stage-icon{background:#248354;border-color:#248354;color:white}
.ppg-i-stage.active .ppg-i-stage-icon{background:#fff6da;border:2px solid #d2a541;color:#9a7317}
.ppg-i-stage strong{display:block;margin-top:3px;color:#36503e;font-size:10px;line-height:1.5}
.ppg-i-stage.completed strong{color:#286745}
.ppg-i-stage p{margin:4px 0 0;color:#839087;font-size:9px;line-height:1.6}
.ppg-i-stage time{display:block;margin-top:4px;color:#929b92;font-size:8px}
.ppg-i-stage-state{padding:5px 6px;border-radius:5px;background:#eef1ed;color:#748176;font-size:8px;font-weight:950;white-space:nowrap}
.ppg-i-stage.active .ppg-i-stage-state{background:#fff0bb;color:#80601b}
.ppg-i-eta{margin-top:16px;padding:15px;border:1px solid #e4eddd;border-radius:10px;background:#f2f7ed}
.ppg-i-eta-label{color:#71846f;font-size:9px;font-weight:950;letter-spacing:.7px}
.ppg-i-eta strong{display:block;margin-top:8px;color:#20553b;font-size:22px;font-weight:950}
.ppg-i-eta p{margin:6px 0 0;color:#849082;font-size:9px;line-height:1.6}
.ppg-i-journey{display:flex;align-items:flex-start;gap:0;overflow-x:auto;padding:7px 0 2px}
.ppg-i-journey-step{position:relative;flex:1;min-width:100px;padding:0 6px;text-align:center}
.ppg-i-journey-step:not(:last-child):after{content:"";position:absolute;top:14px;left:calc(50% + 17px);right:calc(-50% + 17px);height:2px;background:#dfe7db}
.ppg-i-journey-node{position:relative;z-index:1;display:grid;place-items:center;width:29px;height:29px;margin:0 auto 8px;border-radius:50%;background:#e9eee6;color:#718076;font-size:10px;font-weight:950}
.ppg-i-journey-step.completed .ppg-i-journey-node{background:#2b8b58;color:white}
.ppg-i-journey-step.active .ppg-i-journey-node{background:#d8f28a;color:#30481f}
.ppg-i-journey-step strong{display:block;color:#3a5141;font-size:9px;line-height:1.5}
.ppg-i-journey-step p{margin:4px 0 7px;color:#849087;font-size:8px;line-height:1.5}
.ppg-i-journey-step span{display:inline-block;padding:4px 5px;border-radius:5px;background:#edf1e9;color:#667866;font-size:7px;font-weight:950;white-space:nowrap}
.ppg-i-journey-step.completed span{background:#dff0d6;color:#2b7044}
.ppg-i-journey-step.active span{background:#e9f4b7;color:#4b632b}
.ppg-i-items{display:flex;flex-direction:column;gap:7px}
.ppg-i-item{display:grid;grid-template-columns:52px minmax(0,1fr) auto;align-items:center;gap:10px;padding:8px;border:1px solid #e9eee5;border-radius:9px}
.ppg-i-item-img,.ppg-i-item-fallback{width:52px;height:49px;object-fit:cover;border-radius:7px;background:#edf3e8}
.ppg-i-item-fallback{display:grid;place-items:center;color:#52754f;font-size:10px;font-weight:950}
.ppg-i-item strong{display:block;color:#344f3e;font-size:10px;line-height:1.5;overflow-wrap:anywhere}
.ppg-i-item small{display:block;margin-top:3px;color:#8a958b;font-size:8px;line-height:1.5;overflow-wrap:anywhere}
.ppg-i-item-qty{color:#4d694f;font-size:8px;line-height:1.6;text-align:right;white-space:nowrap}
.ppg-i-pay-status{display:inline-block;margin-bottom:11px;padding:6px 8px;border-radius:6px;background:#edf4e3;color:#4d7146;font-size:9px;font-weight:950}
.ppg-i-pay-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.ppg-i-money{padding:12px;border:1px solid #e7eee3;border-radius:9px;background:#fafcf9;min-width:0}
.ppg-i-money span{display:block;color:#849087;font-size:9px}
.ppg-i-money strong{display:block;margin-top:7px;color:#304b3a;font-size:14px;line-height:1.4;overflow-wrap:anywhere}
.ppg-i-money .paid{color:#27744b}
.ppg-i-money.due{background:#fff8e9;border-color:#f2e2c4}
.ppg-i-money.due strong{color:#995e18}
.ppg-i-disclaimer{margin:10px 0 0;color:#879287;font-size:8px;line-height:1.6}
.ppg-i-support{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:15px;border:1px solid #dfe9d8;border-radius:11px;background:#eaf3e4}
.ppg-i-support strong{display:block;color:#34533d;font-size:11px}
.ppg-i-support p{margin:5px 0 0;color:#7c897d;font-size:9px;line-height:1.6}
.ppg-i-support a{flex-shrink:0;padding:10px 12px;border-radius:7px;background:#174a37;color:white!important;text-decoration:none!important;font-size:9px;font-weight:950;white-space:nowrap}
.ppg-i-footer{background:#0c3429;color:#d5e4d9;padding:19px 0;margin-top:20px}
.ppg-i-footer-inner{display:flex;align-items:center;justify-content:space-between;gap:18px}
.ppg-i-footer-brand{font-size:10px;font-weight:950;letter-spacing:.5px}
.ppg-i-footer-brand small{display:block;margin-top:4px;color:#91b39b;font-size:7px;letter-spacing:1.2px}
.ppg-i-footer-links{display:flex;align-items:center;flex-wrap:wrap;gap:17px;color:#d7e5db;font-size:9px}
.ppg-i-footer-links a{color:#d8f28a!important;text-decoration:none}
.ppg-i-message{padding:28px;border:1px solid var(--line);border-radius:13px;background:white;text-align:center;color:#78867b}
.ppg-i-message h2{margin:0 0 8px;color:#274934;font-size:19px}
.ppg-i-message p{font-size:11px;line-height:1.7}
.ppg-i-message a{display:inline-block;margin-top:8px;padding:10px 13px;border-radius:7px;background:var(--lime);color:#2b432e;text-decoration:none;font-size:10px;font-weight:950}
@media(max-width:1280px){
 .ppg-i-order-strip{grid-template-columns:minmax(230px,1.45fr) repeat(3,minmax(125px,1fr));row-gap:8px}
 .ppg-i-product{grid-column:1/-1;border-bottom:1px solid #edf0eb;padding-bottom:12px}
 .ppg-i-metric{border-left:0}
 .ppg-i-main-grid{grid-template-columns:minmax(0,1.2fr) minmax(320px,.9fr)}
 .ppg-i-container{padding-left:22px;padding-right:22px}
}
@media(max-width:900px){
 .ppg-i-main-grid{grid-template-columns:1fr}
 .ppg-i-order-strip{grid-template-columns:repeat(3,minmax(0,1fr))}
 .ppg-i-production{grid-template-columns:minmax(0,1.1fr) minmax(0,1fr)}
}
@media(max-width:600px){
 .ppg-i-container{padding-left:12px;padding-right:12px}
 .ppg-i-header{height:auto;min-height:58px}
 .ppg-i-header-inner{gap:10px}
 .ppg-i-brand{min-width:0;flex:1}
 .ppg-i-brand strong{font-size:10px}
 .ppg-i-brand small{font-size:7px;letter-spacing:.8px}
 .ppg-i-nav,.ppg-i-help{display:none}
 .ppg-i-header-right{gap:5px}
 .ppg-i-contact{padding:9px;font-size:9px}
 .ppg-i-cover-inner{grid-template-columns:1fr;gap:17px;padding-top:24px;padding-bottom:20px}
 .ppg-i-cover h1{font-size:31px}
 .ppg-i-token{max-width:none;padding:12px}
 .ppg-i-order-strip{grid-template-columns:1fr 1fr;padding:10px}
 .ppg-i-product{grid-column:1/-1}
 .ppg-i-metric{padding:6px 0}
 .ppg-i-metric-icon{display:none}
 .ppg-i-metric strong{font-size:10px}
 .ppg-i-stats{grid-template-columns:1fr;gap:7px}
 .ppg-i-stat{padding:12px}
 .ppg-i-stat strong{font-size:14px}
 .ppg-i-main-grid{gap:10px;margin-top:10px}
 .ppg-i-panel{padding:12px}
 .ppg-i-panel-head{gap:7px}
 .ppg-i-panel-head h2{font-size:11px}
 .ppg-i-head-right{font-size:8px}
 .ppg-i-production{grid-template-columns:1fr}
 .ppg-i-job-photo{height:auto;max-height:280px}
 .ppg-i-photo-placeholder{height:180px}
 .ppg-i-operation-name{font-size:22px}
 .ppg-i-machines{grid-template-columns:1fr 1fr}
 .ppg-i-stage{grid-template-columns:28px minmax(0,1fr) auto;gap:7px}
 .ppg-i-stage-state{font-size:7px;padding:4px}
 .ppg-i-pay-grid{gap:6px}
 .ppg-i-money{padding:9px}
 .ppg-i-money strong{font-size:12px}
 .ppg-i-support{align-items:flex-start;flex-direction:column}
 .ppg-i-footer-inner{align-items:flex-start;flex-direction:column}
 .ppg-i-footer-links{gap:10px}
 .ppg-i-journey-step{min-width:98px}
}

/* PPG_REFERENCE_VISUAL_V2 */

/* Page background and true full-width canvas */
body:has(.ppg-industrial-track) {
    background: #f2f6ef !important;
    overflow-x: hidden;
}
body:has(.ppg-industrial-track) .page-content,
body:has(.ppg-industrial-track) .page-content-wrapper,
body:has(.ppg-industrial-track) .web-page-content,
