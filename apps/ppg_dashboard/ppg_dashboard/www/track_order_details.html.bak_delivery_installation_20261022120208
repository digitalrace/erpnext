<script>
(function(){
 const token=(new URLSearchParams(location.search).get("tracking_id")||"").trim().toUpperCase();
 const $=id=>document.getElementById(id);
 const loading=$("ppg-i-loading"),error=$("ppg-i-error"),report=$("ppg-i-report");
 function esc(v){return String(v==null?"":v).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}
 function date(v){if(!v)return "Not scheduled";const d=new Date(String(v).slice(0,10)+"T12:00:00");return isNaN(d)?String(v):d.toLocaleDateString("en-IN",{day:"2-digit",month:"short",year:"numeric"});}
 function money(v,c){try{return new Intl.NumberFormat("en-IN",{style:"currency",currency:c||"INR",maximumFractionDigits:2}).format(Number(v)||0)}catch(e){return(c||"INR")+" "+(Number(v)||0).toFixed(2)}}
 function formatLastUpdated(value){
  if(!value)return "Last updated: Not available";
  const raw=String(value).trim();
  const parsed=new Date(raw.includes("T")?raw:raw.replace(" ","T"));
  if(Number.isNaN(parsed.getTime()))return "Last updated: "+raw;
  return "Last updated: "+parsed.toLocaleString("en-IN",{
   day:"2-digit",month:"short",year:"numeric",
   hour:"2-digit",minute:"2-digit",hour12:true
  });
 }
 function icon(st){if(st==="completed")return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m5 12 4 4L19 6"/></svg>';if(st==="active")return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="8"/><path d="M12 7v5l3 2"/></svg>';return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="8"/></svg>'}
 function fail(msg){loading.style.display="none";report.style.display="none";error.style.display="block";$("ppg-i-error-text").textContent=msg||"Check your Tracking ID and try again."}
  let trackingData = null;
 let selectedTrackedItem = 0;
 const fallbackProductImage = "https://static.wixstatic.com/media/25a63e_ea51857658e749f9bc406c23a561801c~mv2.jpg/v1/fill/w_612%2Ch_459%2Cal_c/25a63e_ea51857658e749f9bc406c23a561801c~mv2.jpg";
 function renderProduction(p,item){
  p=p||{};
  const updatedLabel=$("ppg-i-last-updated");
  if(updatedLabel)updatedLabel.textContent=formatLastUpdated(item&&item.last_updated);
  const ops=p.operations||[];
  const progress=Math.min(100,Math.max(0,Number(p.progress_percent)||0));
  $("ppg-i-current-stage").textContent=p.stage||"Awaiting production planning";
  $("ppg-i-stage-hint").textContent=p.workstation||"Workstation not assigned";
  $("ppg-i-operation").textContent=p.stage||"Awaiting production planning";
  $("ppg-i-prod-status").textContent=p.status||"Not Started";
  $("ppg-i-workstation").textContent=p.workstation||"Not assigned yet";
  $("ppg-i-qty").textContent=String(p.completed_qty||0)+" / "+String(p.stage_qty||0)+" units";
  $("ppg-i-prod-progress").textContent=progress.toFixed(0)+"%";
  $("ppg-i-prod-fill").style.width=progress+"%";
  const subtitle=$("ppg-i-production-subtitle");
  if(subtitle){
   subtitle.textContent=item
    ? (item.item||"Selected item")+" · Serial no.: "+(item.serial_numbers||"Not assigned yet")+" · Current operation and production photo"
    : "Select an item to see its production progress";
  }
  $("ppg-i-photo-wrap").innerHTML=p.photo_url&&String(p.photo_url).startsWith("/files/")
   ?'<img class="ppg-i-job-photo" src="'+esc(p.photo_url)+'" alt="Customer-shareable Job Card photo">'
   :'<div class="ppg-i-photo-placeholder"><span class="ppg-i-photo-tag">ILLUSTRATIVE FACTORY IMAGE</span><span>Live Job Card photo will replace this image when uploaded.</span></div>';
  $("ppg-i-photo-caption").textContent=p.photo_url&&String(p.photo_url).startsWith("/files/")
   ?"Customer-shareable photo uploaded for the current operation."
   :"Illustrative image only — not a photograph of your specific job.";
  $("ppg-i-journey").innerHTML=ops.length?ops.map((o,i)=>{
   const state=["completed","active","pending"].includes(o.state)?o.state:"pending";
   const label=state==="completed"?"COMPLETED":state==="active"?"IN PROGRESS":String(o.status||"QUEUED").toUpperCase();
   return '<div class="ppg-i-journey-step '+state+'"><div class="ppg-i-journey-node">'+(state==="completed"?icon(state):i+1)+'</div><strong>'+esc(o.operation||"Operation")+'</strong><p>'+esc(o.workstation||"Workstation not assigned")+'</p><span>'+esc(label)+'</span></div>';
  }).join(""):'<div style="color:#819087;font-size:10px;line-height:1.7">Production stages will populate from this item\'s actual Work Order operations.</div>';
 }
 function selectTrackedItem(index){
  const items=trackingData&&Array.isArray(trackingData.items)?trackingData.items:[];
  if(index<0||index>=items.length)return;
  selectedTrackedItem=index;
  document.querySelectorAll("[data-ppg-item-index]").forEach(el=>{
   const active=Number(el.getAttribute("data-ppg-item-index"))===index;
   el.classList.toggle("selected",active);
   if(el.hasAttribute("aria-pressed"))el.setAttribute("aria-pressed",active?"true":"false");
  });
  const item=items[index];

  // Refresh delivery details for the selected product.
  const delivery=item.delivery||{};
  const expectedDate=date(delivery.expected_delivery_date);

  $("ppg-i-delivery-date").textContent=expectedDate;
  $("ppg-i-eta").textContent=expectedDate;
  $("ppg-i-eta-stat").textContent=expectedDate;

  const itemDeliveryPercent=Math.min(
   100,Math.max(0,Number(delivery.delivery_percent)||0)
  );
  $("ppg-i-delivery-progress").textContent=itemDeliveryPercent.toFixed(0)+"%";

  renderProduction(item.production||trackingData.production||{},item);
 }
 function itemClickHandler(event){
  const target=event.target.closest("[data-ppg-item-index]");
  if(!target)return;
  event.preventDefault();
  selectTrackedItem(Number(target.getAttribute("data-ppg-item-index")));
 }
 function itemKeyHandler(event){
  if(event.key!=="Enter"&&event.key!==" ")return;
  const target=event.target.closest("[data-ppg-item-index]");
  if(!target)return;
  event.preventDefault();
  selectTrackedItem(Number(target.getAttribute("data-ppg-item-index")));
 }
 $("ppg-i-order-items-selector").addEventListener("click",itemClickHandler);
 $("ppg-i-items").addEventListener("click",itemClickHandler);
 $("ppg-i-items").addEventListener("keydown",itemKeyHandler);
 function render(d){
  const pay=d.payment||{},items=d.items||[],stages=d.stages||[];
  const delivered=Math.min(100,Math.max(0,Number(d.delivery_percent)||0));
  loading.style.display="none";error.style.display="none";report.style.display="block";
  trackingData=d;
  $("ppg-i-token").textContent=token;
  $("ppg-i-order-ref").textContent=d.order_reference||"Order linked";
  $("ppg-i-order-date").textContent=date(d.order_date);
  $("ppg-i-delivery-date").textContent=date(d.estimated_delivery_date);
  $("ppg-i-eta").textContent=date(d.estimated_delivery_date);
  $("ppg-i-eta-stat").textContent=date(d.estimated_delivery_date);
  $("ppg-i-status").textContent=d.overall_status||"Order confirmed";
  $("ppg-i-delivery-progress").textContent=delivered.toFixed(0)+"%";
  $("ppg-i-order-value").textContent=money(pay.order_total,pay.currency);
  $("ppg-i-order-selector-title").textContent="YOUR ORDER · "+items.length+" ITEM"+(items.length===1?"":"S")+" · SELECT AN ITEM";
  $("ppg-i-order-items-selector").innerHTML=items.length?items.map((it,i)=>{
   const img=it.image&&String(it.image).startsWith("/files/")
    ?'<img class="ppg-i-order-select-img" src="'+esc(it.image)+'" alt="'+esc(it.item||"Product")+'">'
    :'<img class="ppg-i-order-select-img" src="'+fallbackProductImage+'" alt="Representative industrial panel image">';
   const serial=it.serial_numbers||"Not assigned yet";
   const delivery=it.delivery||{};
   const deliveryText=(delivery.status||"Awaiting dispatch")+" · Expected "+(delivery.expected_delivery_date?date(delivery.expected_delivery_date):"Not scheduled");
   return '<button type="button" class="ppg-i-order-select '+(i===0?"selected":"")+'" data-ppg-item-index="'+i+'" aria-pressed="'+(i===0?"true":"false")+'">'+img+'<span class="ppg-i-order-select-info"><strong>'+esc(it.item||"Product")+'</strong><small>'+esc(it.item_code||"Item code unavailable")+'</small><small class="ppg-i-order-serial">Serial no.: '+esc(serial)+'</small><small class="ppg-i-order-delivery">'+esc(deliveryText)+'</small></span><span class="ppg-i-order-select-qty">'+esc(it.qty)+' ordered<br>'+esc(delivery.delivered_qty!=null?delivery.delivered_qty:it.delivered_qty)+' delivered</span></button>';
  }).join(""):'<div style="font-size:10px;color:#819087">Order item details are unavailable.</div>';
  $("ppg-i-items").innerHTML=items.length?items.map((it,i)=>{
   const img=it.image&&String(it.image).startsWith("/files/")
    ?'<img class="ppg-i-item-img" src="'+esc(it.image)+'" alt="'+esc(it.item||"Product")+'">'
    :'<img class="ppg-i-item-img" src="'+fallbackProductImage+'" alt="Representative industrial panel image">';
   const serial=it.serial_numbers||"Not assigned yet";
   const delivery=it.delivery||{};
   const deliveryText=(delivery.status||"Awaiting dispatch")+" · Expected "+(delivery.expected_delivery_date?date(delivery.expected_delivery_date):"Not scheduled");
   return '<div class="ppg-i-item '+(i===0?"selected":"")+'" role="button" tabindex="0" aria-pressed="'+(i===0?"true":"false")+'" data-ppg-item-index="'+i+'">'+img+'<div><strong>'+esc(it.item||"Product")+'</strong><small>'+esc(it.item_code||"Item reference unavailable")+'<br>Serial no.: '+esc(serial)+'<br><span class="ppg-i-item-delivery">'+esc(deliveryText)+'</span></small></div><div class="ppg-i-item-qty">ORDERED<br>'+esc(it.qty)+' units<br>DELIVERED '+esc(delivery.delivered_qty!=null?delivery.delivered_qty:it.delivered_qty)+'</div></div>';
  }).join(""):'<div style="color:#819087;font-size:10px">Order item details are unavailable.</div>';
  const stNames=["completed","active","pending"];
  const sharedStages=stages.filter(s=>/order confirmed|installation|handover/i.test(String(s.label||"")));
  $("ppg-i-timeline").innerHTML=sharedStages.length?sharedStages.map(s=>{
   const state=stNames.includes(s.state)?s.state:"pending";
   return '<div class="ppg-i-stage '+state+'"><div class="ppg-i-stage-icon">'+icon(state)+'</div><div><strong>'+esc(s.label)+'</strong><p>'+esc(s.detail)+'</p>'+(s.date?'<time>'+esc(date(s.date))+'</time>':'')+'</div><span class="ppg-i-stage-state">'+(state==="completed"?"COMPLETED":state==="active"?"IN PROGRESS":"PENDING")+'</span></div>';
  }).join(""):'<div style="color:#819087;font-size:10px">Installation and handover updates will appear here when recorded.</div>';
  $("ppg-i-pay-status").textContent=pay.status||"Payment information unavailable";
  $("ppg-i-money-total").textContent=money(pay.order_total,pay.currency);
  $("ppg-i-money-invoiced").textContent=money(pay.invoiced_amount,pay.currency);
  $("ppg-i-money-paid").textContent=money(pay.paid_amount,pay.currency);
  $("ppg-i-money-due").textContent=money(pay.balance_due,pay.currency);
  if(items.length)selectTrackedItem(0);
  else renderProduction(d.production||{},null);
 }
$("ppg-i-copy").addEventListener("click",function(){
  if(navigator.clipboard&&navigator.clipboard.writeText)navigator.clipboard.writeText(token).then(()=>{$("ppg-i-copy").textContent="Copied";}).catch(()=>{});
 });
 if(!token){fail("Go back to tracking search and enter your Tracking ID.");return}
 fetch("/api/method/ppg_dashboard.api.customer_tracking.get_order_tracking?tracking_id="+encodeURIComponent(token),{headers:{"Accept":"application/json"}})
 .then(async r=>{const body=await r.json();if(!r.ok)throw new Error();return body.message||{}})
 .then(d=>{if(!d.found){fail(d.message||"Tracking ID not found. Please check it and try again.");return}render(d)})
 .catch(()=>fail("We could not load your order report. Please try again in a moment."));
})();
</script>
