      <div id="ppg-i-journey" class="ppg-i-journey"></div>
     </section>

     <section class="ppg-i-panel">
      <div class="ppg-i-panel-head"><div class="ppg-i-panel-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16l-1 13H5L4 7ZM9 7a3 3 0 0 1 6 0"/></svg></div><div><h2>ORDER ITEMS</h2><p>Products, quantities and delivered serial references where available</p></div></div>
      <div id="ppg-i-items" class="ppg-i-items"></div>
     </section>
    </div>

    <div class="ppg-i-col">
     <section class="ppg-i-panel">
      <div class="ppg-i-panel-head"><div class="ppg-i-panel-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7h11v11H3zM14 11h4l3 3v4h-7zM7 21a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM18 21a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/></svg></div><div><h2>DELIVERY & INSTALLATION</h2><p>Track the next steps until your order is handed over</p></div></div>
      <div id="ppg-i-timeline" class="ppg-i-timeline"></div>
      <div class="ppg-i-eta"><div class="ppg-i-eta-label">ESTIMATED DELIVERY DATE</div><strong id="ppg-i-eta">Not scheduled</strong><p>Based on the delivery date currently recorded in ERP.</p></div>
     </section>

     <section class="ppg-i-panel">
      <div class="ppg-i-panel-head"><div class="ppg-i-panel-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M7 15h4"/></svg></div><div><h2>PAYMENT SUMMARY</h2><p>Payment status for this order · Not a tax invoice</p></div></div>
      <div id="ppg-i-pay-status" class="ppg-i-pay-status">Loading</div>
      <div class="ppg-i-pay-grid">
       <div class="ppg-i-money"><span>Order total</span><strong id="ppg-i-money-total">—</strong></div>
       <div class="ppg-i-money"><span>Invoiced amount</span><strong id="ppg-i-money-invoiced">—</strong></div>
       <div class="ppg-i-money"><span>Paid amount</span><strong id="ppg-i-money-paid" class="paid">—</strong></div>
       <div class="ppg-i-money due"><span>Balance due</span><strong id="ppg-i-money-due">—</strong></div>
      </div>
      <p class="ppg-i-disclaimer">Customer summary only. Contact our team for invoice copies, receipts or account reconciliation.</p>
     </section>

     <section class="ppg-i-support"><div><strong>Need a hand with your order?</strong><p>Share your Tracking ID with our support team for faster assistance.</p></div><a href="mailto:powerpartnerhq@gmail.com">CONTACT SUPPORT&nbsp; →</a></section>
    </div>
   </div>
  </div>
 </div>

 <footer class="ppg-i-footer"><div class="ppg-i-container ppg-i-footer-inner"><div class="ppg-i-footer-brand">
      <span class="ppg-i-footer-logo">
       <svg viewBox="0 0 40 40" aria-hidden="true">
        <circle cx="20" cy="20" r="17" fill="#eaf4dc" stroke="#72ad5c" stroke-width="2"/>
        <path d="M20 5l3.5 8 8-3-3 8 7.5 4-8 3 1 8-7-5-7 5 1-8-8-3 7.5-4-3-8 8 3z" fill="#3e8650"/>
        <circle cx="20" cy="20" r="4.4" fill="#d8f28a" stroke="#276b43" stroke-width="1.4"/>
       </svg>
      </span>
      <span>POWER PARTNER GLOBAL PVT. LTD.<small>ENGINEERING A BETTER TOMORROW</small></span>
     </div><div class="ppg-i-footer-links"><a href="/track-order">Order Tracking</a><span>Support</span><span>India</span></div></div></footer>
</div>

<script>
(function(){
 const token=(new URLSearchParams(location.search).get("tracking_id")||"").trim().toUpperCase();
 const $=id=>document.getElementById(id);
 const loading=$("ppg-i-loading"),error=$("ppg-i-error"),report=$("ppg-i-report");
 function esc(v){return String(v==null?"":v).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}
 function date(v){if(!v)return "Not scheduled";const d=new Date(String(v).slice(0,10)+"T12:00:00");return isNaN(d)?String(v):d.toLocaleDateString("en-IN",{day:"2-digit",month:"short",year:"numeric"});}
 function money(v,c){try{return new Intl.NumberFormat("en-IN",{style:"currency",currency:c||"INR",maximumFractionDigits:2}).format(Number(v)||0)}catch(e){return(c||"INR")+" "+(Number(v)||0).toFixed(2)}}
 function icon(st){if(st==="completed")return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m5 12 4 4L19 6"/></svg>';if(st==="active")return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="8"/><path d="M12 7v5l3 2"/></svg>';return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="8"/></svg>'}
 function fail(msg){loading.style.display="none";report.style.display="none";error.style.display="block";$("ppg-i-error-text").textContent=msg||"Check your Tracking ID and try again."}
 function render(d){
  const p=d.production||{},pay=d.payment||{},items=d.items||[],stages=d.stages||[],ops=p.operations||[];
  const delivered=Math.min(100,Math.max(0,Number(d.delivery_percent)||0));
  const progress=Math.min(100,Math.max(0,Number(p.progress_percent)||0));
  loading.style.display="none";error.style.display="none";report.style.display="block";
  $("ppg-i-token").textContent=token;
  $("ppg-i-order-ref").textContent=d.order_reference||"Order linked";
  $("ppg-i-order-date").textContent=date(d.order_date);
  $("ppg-i-delivery-date").textContent=date(d.estimated_delivery_date);
  $("ppg-i-eta").textContent=date(d.estimated_delivery_date);
  $("ppg-i-eta-stat").textContent=date(d.estimated_delivery_date);
  $("ppg-i-status").textContent=d.overall_status||"Order confirmed";
  $("ppg-i-delivery-progress").textContent=delivered.toFixed(0)+"%";
  $("ppg-i-current-stage").textContent=p.stage||"Awaiting production planning";
  $("ppg-i-stage-hint").textContent=p.workstation||"Workstation not assigned";
  $("ppg-i-order-value").textContent=money(pay.order_total,pay.currency);
  $("ppg-i-product-name").textContent=items.length?items[0].item:"Order items";
  $("ppg-i-product-code").textContent=items.length?(items[0].item_code||"Product details"):"Products linked to this order";
  $("ppg-i-product-image").innerHTML=items.length&&items[0].image&&String(items[0].image).startsWith("/files/")
   ?'<img class="ppg-i-product-img" src="'+esc(items[0].image)+'" alt="'+esc(items[0].item||"Product")+'">'
   :'<img class="ppg-i-product-img" src="https://static.wixstatic.com/media/25a63e_ea51857658e749f9bc406c23a561801c~mv2.jpg/v1/fill/w_612%2Ch_459%2Cal_c/25a63e_ea51857658e749f9bc406c23a561801c~mv2.jpg" alt="Representative industrial panel image" title="Representative image; replace with the Item image when available">';
  $("ppg-i-operation").textContent=p.stage||"Awaiting production planning";
  $("ppg-i-prod-status").textContent=p.status||"Not Started";
  $("ppg-i-workstation").textContent=p.workstation||"Not assigned yet";
  $("ppg-i-qty").textContent=String(p.completed_qty||0)+" / "+String(p.stage_qty||0)+" units";
  $("ppg-i-prod-progress").textContent=progress.toFixed(0)+"%";
  $("ppg-i-prod-fill").style.width=progress+"%";
  $("ppg-i-photo-wrap").innerHTML=p.photo_url&&String(p.photo_url).startsWith("/files/")
   ?'<img class="ppg-i-job-photo" src="'+esc(p.photo_url)+'" alt="Customer-shareable Job Card photo">'
   :'<div class="ppg-i-photo-placeholder"><span class="ppg-i-photo-tag">ILLUSTRATIVE FACTORY IMAGE</span><span>Live Job Card photo will replace this image when uploaded.</span></div>';
  $("ppg-i-photo-caption").textContent=p.photo_url&&String(p.photo_url).startsWith("/files/")
   ?"Customer-shareable photo uploaded for the current operation."
   :"Illustrative image only — not a photograph of your specific job.";
  $("ppg-i-operations").innerHTML=ops.length?ops.map(o=>{
   const s=["completed","active","pending"].includes(o.state)?o.state:"pending";
   return '<div class="ppg-i-operation-row"><span class="ppg-i-op-dot '+s+'"></span><div><strong>'+esc(o.operation||"Production operation")+'</strong><small>'+esc(o.workstation||"Workstation not assigned")+'</small></div><span class="ppg-i-op-state">'+esc(o.status||"Pending")+'</span></div>';
  }).join(""):'<div style="color:#819087;font-size:10px;line-height:1.7;padding:8px 0">No Work Order operations are linked to this Sales Order yet. The operation list appears when production planning is created.</div>';
  $("ppg-i-journey").innerHTML=ops.length?ops.map((o,i)=>{
   const s=["completed","active","pending"].includes(o.state)?o.state:"pending";
   const label=s==="completed"?"COMPLETED":s==="active"?"IN PROGRESS":String(o.status||"QUEUED").toUpperCase();
   return '<div class="ppg-i-journey-step '+s+'"><div class="ppg-i-journey-node">'+(s==="completed"?icon(s):i+1)+'</div><strong>'+esc(o.operation||"Operation")+'</strong><p>'+esc(o.workstation||"Workstation not assigned")+'</p><span>'+esc(label)+'</span></div>';
  }).join(""):'<div style="color:#819087;font-size:10px;line-height:1.7">Production stages will populate from the actual Work Order operations.</div>';
  $("ppg-i-timeline").innerHTML=stages.length?stages.map(s=>{
   const st=["completed","active","pending"].includes(s.state)?s.state:"pending";
   return '<div class="ppg-i-stage '+st+'"><div class="ppg-i-stage-icon">'+icon(st)+'</div><div><strong>'+esc(s.label)+'</strong><p>'+esc(s.detail)+'</p>'+(s.date?'<time>'+esc(date(s.date))+'</time>':'')+'</div><span class="ppg-i-stage-state">'+(st==="completed"?"COMPLETED":st==="active"?"IN PROGRESS":"PENDING")+'</span></div>';
  }).join(""):'<div style="color:#819087;font-size:10px">No delivery milestones recorded yet.</div>';
  $("ppg-i-items").innerHTML=items.length?items.map(it=>{
   const img=it.image&&String(it.image).startsWith("/files/")?'<img class="ppg-i-item-img" src="'+esc(it.image)+'" alt="'+esc(it.item||"Product")+'">':'<img class="ppg-i-item-img" src="https://static.wixstatic.com/media/25a63e_ea51857658e749f9bc406c23a561801c~mv2.jpg/v1/fill/w_612%2Ch_459%2Cal_c/25a63e_ea51857658e749f9bc406c23a561801c~mv2.jpg" alt="Representative industrial panel image" title="Representative image; replace with the Item image when available">';
   const serial=it.serial_numbers?'<br>Serial no.: '+esc(it.serial_numbers):"";
   return '<div class="ppg-i-item">'+img+'<div><strong>'+esc(it.item||"Product")+'</strong><small>'+esc(it.item_code||"Item reference unavailable")+serial+'</small></div><div class="ppg-i-item-qty">ORDERED<br>'+esc(it.qty)+' units<br>DELIVERED '+esc(it.delivered_qty)+'</div></div>';
  }).join(""):'<div style="color:#819087;font-size:10px">Order item details are unavailable.</div>';
  $("ppg-i-pay-status").textContent=pay.status||"Payment information unavailable";
  $("ppg-i-money-total").textContent=money(pay.order_total,pay.currency);
  $("ppg-i-money-invoiced").textContent=money(pay.invoiced_amount,pay.currency);
  $("ppg-i-money-paid").textContent=money(pay.paid_amount,pay.currency);
  $("ppg-i-money-due").textContent=money(pay.balance_due,pay.currency);
 }
 $("ppg-i-copy").addEventListener("click",function(){
  if(navigator.clipboard&&navigator.clipboard.writeText)navigator.clipboard.writeText(token).then(()=>{$("ppg-i-copy").textContent="Copied";}).catch(()=>{});
 });
 if(!token){fail("Go back to tracking search and enter your Tracking ID.");return}
 fetch("/api/method/ppg_dashboard.api.customer_tracking.get_order_tracking?tracking_id="+encodeURIComponent(token),{headers:{"Accept":"application/json"}})
 .then(async r=>{const body=await r.json();if(!r.ok)throw new Error();return body.message||{}})
 .then(d=>{if(!d.found){fail(d.message||"Tracking ID not found. Please check it and try again.");return}render(d)})
 .catch(()=>fail("We could not load your order report. Please try again in a moment."));
})();
</script>
{% endblock %}
