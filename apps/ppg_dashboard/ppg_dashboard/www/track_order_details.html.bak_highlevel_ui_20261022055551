<script>
(function () {
 const token = (new URLSearchParams(window.location.search).get("tracking_id") || "").trim().toUpperCase();
 const loading = document.getElementById("ppg-detail-loading");
 const error = document.getElementById("ppg-detail-error");
 const errorText = document.getElementById("ppg-detail-error-text");
 const content = document.getElementById("ppg-detail-content");

 function esc(v) {
  return String(v == null ? "" : v).replace(/[&<>"']/g, function(c) {
   return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c];
  });
 }
 function showError(msg) {
  loading.style.display = "none";
  content.style.display = "none";
  error.style.display = "block";
  errorText.textContent = msg || "Please check the Tracking ID and try again.";
 }
 function money(value, currency) {
  try {
   return new Intl.NumberFormat("en-IN", {
    style:"currency", currency:currency || "INR", maximumFractionDigits:2
   }).format(Number(value) || 0);
  } catch (e) {
   return (currency || "INR") + " " + (Number(value) || 0).toFixed(2);
  }
 }
 function stageIcon(state) {
  if (state === "completed") return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m5 12 4 4L19 6"/></svg>';
  if (state === "active") return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="8"/><path d="M12 7v5l3 2"/></svg>';
  return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="8"/></svg>';
 }
 function render(data) {
  loading.style.display = "none";
  error.style.display = "none";
  content.style.display = "block";

  const production = data.production || {};
  const payment = data.payment || {};
  const percent = Math.max(0, Math.min(100, Number(data.delivery_percent) || 0));
  const stagePercent = Math.max(0, Math.min(100, Number(production.progress_percent) || 0));

  document.getElementById("ppg-detail-token").textContent = token;
  document.getElementById("ppg-detail-overall").textContent = data.overall_status || "Order confirmed";
  document.getElementById("ppg-detail-dates").textContent =
   "Placed " + (data.order_date || "date unavailable") +
   " · Expected delivery " + (data.estimated_delivery_date || "not available");
  document.getElementById("ppg-detail-percent").textContent = percent.toFixed(0) + "%";
  document.getElementById("ppg-detail-progress-fill").style.width = percent + "%";
  document.getElementById("ppg-detail-order-date").textContent = data.order_date || "—";
  document.getElementById("ppg-detail-delivery-date").textContent = data.estimated_delivery_date || "Not scheduled";
  document.getElementById("ppg-detail-stage").textContent = production.stage || "Not planned";
  document.getElementById("ppg-detail-stage-hint").textContent = production.workstation || "Workstation not assigned";

  const photo = production.photo_url && String(production.photo_url).startsWith("/files/")
   ? '<img class="ppg-detail-photo" src="' + esc(production.photo_url) + '" alt="Customer-shareable production photo">'
   : '<div class="ppg-detail-no-photo"><span>PRODUCTION PHOTO</span>No customer-shareable photo has been uploaded for this stage yet.</div>';
  document.getElementById("ppg-detail-photo-wrap").innerHTML = photo;
  document.getElementById("ppg-detail-operation").textContent = production.stage || "Awaiting production planning";
  document.getElementById("ppg-detail-workstation").innerHTML =
   'Workstation: <strong>' + esc(production.workstation || "Not assigned yet") + '</strong>';
  document.getElementById("ppg-detail-production-status").textContent = production.status || "Not Started";
  document.getElementById("ppg-detail-production-qty").textContent =
   String(production.completed_qty || 0) + " of " + String(production.stage_qty || 0) + " units completed";
  document.getElementById("ppg-detail-production-fill").style.width = stagePercent + "%";

  const operations = production.operations || [];
  document.getElementById("ppg-detail-operations").innerHTML = operations.length
   ? operations.map(function(op) {
      const state = ["completed","active","pending"].includes(op.state) ? op.state : "pending";
      return '<div class="ppg-detail-op"><span class="ppg-detail-op-dot ' + state + '"></span>' +
       '<div><strong>' + esc(op.operation || "Production operation") + '</strong><small>' +
       esc(op.workstation || "Workstation not assigned") + '</small></div><span class="ppg-detail-op-state">' +
       esc(op.status || "Pending") + '</span></div>';
     }).join("")
   : '<p style="color:#879189;font-size:11px;line-height:1.7">Work Order operations will appear here when production planning is linked to this Sales Order.</p>';

  const stages = data.stages || [];
  document.getElementById("ppg-detail-timeline").innerHTML = stages.length
   ? stages.map(function(s) {
      const state = ["completed","active","pending"].includes(s.state) ? s.state : "pending";
      return '<div class="ppg-detail-stage ' + state + '"><div class="ppg-detail-stage-icon">' +
       stageIcon(state) + '</div><div><strong>' + esc(s.label) + '</strong><p>' +
       esc(s.detail) + '</p>' + (s.date ? '<time>' + esc(s.date) + '</time>' : '') +
       '</div></div>';
     }).join("")
   : '<p style="color:#879189;font-size:11px">No milestones are available yet.</p>';

  const items = data.items || [];
  document.getElementById("ppg-detail-items").innerHTML = items.length
   ? items.map(function(item) {
      const img = item.image && String(item.image).startsWith("/files/")
       ? '<img class="ppg-detail-item-img" src="' + esc(item.image) + '" alt="' + esc(item.item) + '">'
       : '<div class="ppg-detail-item-placeholder">PP</div>';
      return '<div class="ppg-detail-item">' + img + '<div><div class="ppg-detail-item-name">' +
       esc(item.item || "Product") + '</div><div class="ppg-detail-item-meta">Ordered: ' +
       esc(item.qty) + '<br>Delivered: ' + esc(item.delivered_qty) + '</div></div>' +
       '<div class="ppg-detail-item-qty">Qty<br>' + esc(item.qty) + '</div></div>';
     }).join("")
   : '<p style="color:#879189;font-size:11px">Item information is not available.</p>';

  document.getElementById("ppg-detail-payment-status").textContent =
   payment.status || "Payment information unavailable";
  document.getElementById("ppg-money-total").textContent = money(payment.order_total, payment.currency);
  document.getElementById("ppg-money-invoiced").textContent = money(payment.invoiced_amount, payment.currency);
  document.getElementById("ppg-money-paid").textContent = money(payment.paid_amount, payment.currency);
  document.getElementById("ppg-money-due").textContent = money(payment.balance_due, payment.currency);
 }

 if (!token) {
  showError("Enter your Tracking ID from the tracking search page to view this report.");
  return;
 }

 fetch("/api/method/ppg_dashboard.api.customer_tracking.get_order_tracking?tracking_id=" + encodeURIComponent(token), {
  headers: {"Accept":"application/json"}
 }).then(function(response) {
  return response.json().then(function(body) {
   if (!response.ok) throw new Error("Unable to retrieve this order right now.");
   return body.message || {};
  });
 }).then(function(data) {
  if (!data.found) {
   showError(data.message || "Tracking ID not found. Please check it and try again.");
   return;
  }
  render(data);
 }).catch(function() {
  showError("We could not load the order report. Please try again in a moment.");
 });
})();
</script>
{% endblock %}
