  <div id="ppg-pro-loading" class="ppg-pro-message"><h2>Preparing your order report</h2><p>Retrieving the latest available order, production, delivery and payment updates.</p></div>
  <div id="ppg-pro-error" class="ppg-pro-message" style="display:none"><h2>We couldn't find this order</h2><p id="ppg-pro-error-text">Please check your Tracking ID and try again.</p><a href="/track-order">Back to tracking search</a></div>

  <div id="ppg-pro-content" style="display:none">
   <section class="ppg-pro-hero">
    <div><div class="ppg-pro-kicker">POWER PARTNER GLOBAL · CUSTOMER ORDER TRACKING</div><h1>Your order, clearly <span>in progress.</span></h1><p>From manufacturing to delivery and installation, follow your order's journey with the latest information available in ERP.</p></div>
    <div class="ppg-pro-token"><label>TRACKING ID</label><strong id="ppg-pro-token"></strong><button type="button" id="ppg-pro-copy">Copy Tracking ID</button></div>
   </section>

   <section class="ppg-pro-summary">
    <div class="ppg-pro-product"><div id="ppg-pro-main-image"></div><div style="min-width:0"><span class="ppg-pro-summary-label">YOUR ORDER</span><strong id="ppg-pro-main-product" class="ppg-pro-product-name">Order items</strong><span id="ppg-pro-main-code" class="ppg-pro-product-sub">Product summary</span></div></div>
    <div class="ppg-pro-metric"><div class="ppg-pro-metric-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 4h14v16H5zM8 8h8M8 12h8M8 16h5"/></svg></div><div><label>Customer order</label><strong id="ppg-pro-order-ref">—</strong></div></div>
    <div class="ppg-pro-metric"><div class="ppg-pro-metric-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4M16 3v4M4 10h16"/></svg></div><div><label>Order date</label><strong id="ppg-pro-order-date">—</strong></div></div>
    <div class="ppg-pro-metric"><div class="ppg-pro-metric-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7h11v11H3zM14 11h4l3 3v4h-7zM7 21a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM18 21a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/></svg></div><div><label>Expected delivery</label><strong id="ppg-pro-delivery-date">—</strong></div></div>
    <div class="ppg-pro-metric"><div class="ppg-pro-metric-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3 20 7v10l-8 4-8-4V7zM8 10h8M8 14h8"/></svg></div><div><label>Order status</label><strong><span class="ppg-pro-status" id="ppg-pro-status">—</span></strong></div></div>
   </section>

   <section class="ppg-pro-stats">
    <div class="ppg-pro-stat"><label>DELIVERY PROGRESS</label><strong id="ppg-pro-delivery-percent">0%</strong><small>Quantity delivered against the order</small></div>
    <div class="ppg-pro-stat"><label>CURRENT PRODUCTION STAGE</label><strong id="ppg-pro-stage-stat">Not available</strong><small id="ppg-pro-stage-hint">Based on linked work orders</small></div>
    <div class="ppg-pro-stat"><label>ORDER VALUE</label><strong id="ppg-pro-total-stat">—</strong><small>Order total from ERP</small></div>
   </section>

   <div class="ppg-pro-grid">
    <section class="ppg-pro-panel">
     <div class="ppg-pro-panel-head"><div class="ppg-pro-panel-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21h18M5 21V9l7-6 7 6v12M9 21v-7h6v7"/></svg></div><div><h2>LIVE PRODUCTION</h2><p>Current operation, workstation and latest production photo</p></div><div class="ppg-pro-updated"><span class="ppg-pro-live-dot"></span>ERP linked</div></div>
     <div class="ppg-pro-production-layout">
      <div><div id="ppg-pro-photo-wrap"></div><div id="ppg-pro-photo-caption" class="ppg-pro-photo-caption"></div></div>
      <div>
       <div class="ppg-pro-operation-kicker">CURRENT OPERATION</div><h2 id="ppg-pro-current-operation" class="ppg-pro-current-operation">Awaiting production planning</h2>
       <span id="ppg-pro-prod-status" class="ppg-pro-pill">Not Started</span>
       <div class="ppg-pro-machine-row">
        <div class="ppg-pro-machine"><div class="ppg-pro-machine-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 20h18M5 20V8h14v12M8 8V4h8v4M8 12h3M8 16h3M15 12h1M15 16h1"/></svg></div><div><small>WORKSTATION</small><strong id="ppg-pro-workstation">Not assigned</strong></div></div>
        <div class="ppg-pro-machine"><div class="ppg-pro-machine-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg></div><div><small>PRODUCTION QTY</small><strong id="ppg-pro-prod-qty">0 / 0 units</strong></div></div>
       </div>
       <div class="ppg-pro-progress-head"><span>Current operation progress</span><strong id="ppg-pro-prod-percent">0%</strong></div>
       <div class="ppg-pro-progress"><div id="ppg-pro-prod-fill" class="ppg-pro-progress-fill" style="width:0%"></div></div>
      </div>
     </div>
     <hr class="ppg-pro-section-divider">
     <div class="ppg-pro-ops-heading">WORK ORDER OPERATIONS</div><div id="ppg-pro-ops" class="ppg-pro-ops-list"></div>
    </section>

    <section class="ppg-pro-panel">
     <div class="ppg-pro-panel-head"><div class="ppg-pro-panel-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7h11v11H3zM14 11h4l3 3v4h-7zM7 21a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM18 21a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/></svg></div><div><h2>DELIVERY & INSTALLATION</h2><p>Track progress through delivery and handover</p></div></div>
     <div id="ppg-pro-timeline" class="ppg-pro-timeline"></div>
     <div class="ppg-pro-eta"><div class="ppg-pro-eta-top"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4M16 3v4M4 10h16"/></svg>ESTIMATED DELIVERY DATE</div><strong id="ppg-pro-eta-date">Not scheduled</strong><p>Based on the delivery date currently recorded in ERP. Please contact our team if your schedule changes.</p></div>
    </section>
   </div>

   <div class="ppg-pro-lower-grid">
    <section class="ppg-pro-panel">
     <div class="ppg-pro-panel-head"><div class="ppg-pro-panel-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 12a8 8 0 1 1 3 6M4 18v-6h6"/></svg></div><div><h2>YOUR PRODUCTION JOURNEY</h2><p>Manufacturing operations for this order</p></div></div>
     <div id="ppg-pro-journey" class="ppg-pro-production-journey"></div>
    </section>

    <section class="ppg-pro-panel">
     <div class="ppg-pro-panel-head"><div class="ppg-pro-panel-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16l-1 13H5L4 7ZM9 7a3 3 0 0 1 6 0"/></svg></div><div><h2>PAYMENT SUMMARY</h2><p>Financial summary for this order</p></div></div>
     <div id="ppg-pro-pay-status" class="ppg-pro-payment-status">Payment status unavailable</div>
     <div class="ppg-pro-payment-grid">
      <div class="ppg-pro-money"><span>Order total</span><strong id="ppg-pro-money-total">—</strong></div>
      <div class="ppg-pro-money"><span>Invoiced amount</span><strong id="ppg-pro-money-invoiced">—</strong></div>
      <div class="ppg-pro-money"><span>Paid amount</span><strong id="ppg-pro-money-paid" class="paid">—</strong></div>
      <div class="ppg-pro-money due"><span>Balance due</span><strong id="ppg-pro-money-due">—</strong></div>
     </div>
     <p style="margin:11px 0 0;color:#889389;font-size:9px;line-height:1.65">Customer summary only. This is not a tax invoice or a payment receipt.</p>
    </section>
   </div>

   <section class="ppg-pro-panel" style="margin-top:14px">
    <div class="ppg-pro-panel-head"><div class="ppg-pro-panel-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16v13H4zM8 7V4h8v3M8 12h8M8 16h5"/></svg></div><div><h2>ORDER ITEMS</h2><p>Products, item references, quantities and delivered serial numbers where recorded</p></div></div>
    <div id="ppg-pro-items" class="ppg-pro-items"></div>
   </section>

   <div class="ppg-pro-contact"><div><strong>Need a hand with your order?</strong><p>Our team can help with production progress, delivery scheduling, installation or payment queries. Share your Tracking ID when contacting us.</p></div><a href="mailto:powerpartnerhq@gmail.com">CONTACT SUPPORT&nbsp; →</a></div>
  </div>

  <footer class="ppg-pro-footer"><div><strong>POWER PARTNER GLOBAL PVT. LTD.</strong><div style="margin-top:5px">Engineering a better tomorrow</div></div><div>ORDER TRACKING&nbsp; · &nbsp; CUSTOMER SUPPORT</div></footer>
 </div>
</section>

<script>
(function(){
 const token=(new URLSearchParams(location.search).get("tracking_id")||"").trim().toUpperCase();
 const $=id=>document.getElementById(id);
 const loading=$("ppg-pro-loading"), error=$("ppg-pro-error"), content=$("ppg-pro-content");
 function esc(v){return String(v==null?"":v).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}
 function date(v){
  if(!v)return "Not scheduled";
  const d=new Date(String(v).slice(0,10)+"T12:00:00");
  return isNaN(d.getTime())?String(v):d.toLocaleDateString("en-IN",{day:"2-digit",month:"short",year:"numeric"});
 }
 function money(v,c){
  try{return new Intl.NumberFormat("en-IN",{style:"currency",currency:c||"INR",maximumFractionDigits:2}).format(Number(v)||0);}
  catch(e){return (c||"INR")+" "+(Number(v)||0).toFixed(2);}
 }
 function icon(state){
  if(state==="completed")return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m5 12 4 4L19 6"/></svg>';
  if(state==="active")return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="8"/><path d="M12 7v5l3 2"/></svg>';
  return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="8"/></svg>';
 }
 function showError(text){
  loading.style.display="none";content.style.display="none";error.style.display="block";$("ppg-pro-error-text").textContent=text||"Check your Tracking ID and try again.";
 }
 function render(data){
  const prod=data.production||{}, pay=data.payment||{}, items=data.items||[], stages=data.stages||[];
  const delivered=Math.max(0,Math.min(100,Number(data.delivery_percent)||0));
  const progress=Math.max(0,Math.min(100,Number(prod.progress_percent)||0));
  const main=items[0]||{};
  loading.style.display="none";error.style.display="none";content.style.display="block";

  $("ppg-pro-token").textContent=token;
  $("ppg-pro-order-ref").textContent=data.order_reference||"Order linked";
  $("ppg-pro-order-date").textContent=date(data.order_date);
  $("ppg-pro-delivery-date").textContent=date(data.estimated_delivery_date);
  $("ppg-pro-eta-date").textContent=date(data.estimated_delivery_date);
  $("ppg-pro-status").textContent=data.overall_status||"Order confirmed";
  $("ppg-pro-delivery-percent").textContent=delivered.toFixed(0)+"%";
  $("ppg-pro-stage-stat").textContent=prod.stage||"Awaiting production planning";
  $("ppg-pro-stage-hint").textContent=prod.workstation||"Workstation not assigned";
  $("ppg-pro-total-stat").textContent=money(pay.order_total,pay.currency);

  $("ppg-pro-main-product").textContent=main.item||"Order items";
  $("ppg-pro-main-code").textContent=main.item_code||"Products linked to this order";
  $("ppg-pro-main-image").innerHTML=main.image&&String(main.image).startsWith("/files/")
    ?'<img class="ppg-pro-product-img" src="'+esc(main.image)+'" alt="'+esc(main.item||"Product")+'">'
    :'<div class="ppg-pro-product-placeholder">PP</div>';

  $("ppg-pro-prod-percent").textContent=progress.toFixed(0)+"%";
  $("ppg-pro-current-operation").textContent=prod.stage||"Awaiting production planning";
  $("ppg-pro-workstation").textContent=prod.workstation||"Not assigned yet";
  $("ppg-pro-prod-status").textContent=prod.status||"Not Started";
  $("ppg-pro-prod-qty").textContent=String(prod.completed_qty||0)+" / "+String(prod.stage_qty||0)+" units";
  $("ppg-pro-prod-fill").style.width=progress+"%";

  $("ppg-pro-photo-wrap").innerHTML=prod.photo_url&&String(prod.photo_url).startsWith("/files/")
    ?'<img class="ppg-pro-production-photo" src="'+esc(prod.photo_url)+'" alt="Production photo for current operation">'
    :'<div class="ppg-pro-photo-placeholder"><span class="ppg-pro-photo-badge">CURRENT JOB PHOTO</span>No customer-shareable photo has been uploaded for this production stage yet.</div>';
  $("ppg-pro-photo-caption").textContent=prod.photo_url&&String(prod.photo_url).startsWith("/files/")
    ?"Photo uploaded for the current production stage."
    :"Your team can upload a customer-shareable photo from the Job Card.";

  const ops=prod.operations||[];
  $("ppg-pro-ops").innerHTML=ops.length?ops.map(o=>{
   const st=["completed","active","pending"].includes(o.state)?o.state:"pending";
   return '<div class="ppg-pro-op"><span class="ppg-pro-op-dot '+st+'"></span><div><strong>'+esc(o.operation||"Production operation")+'</strong><small>'+esc(o.workstation||"Workstation not assigned")+'</small></div><span class="ppg-pro-op-state">'+esc(o.status||"Pending")+'</span></div>';
  }).join(""):'<p style="color:#849087;font-size:10px;line-height:1.7">No Work Order operations are linked to this order yet. The production journey will populate when production planning is created.</p>';

  $("ppg-pro-journey").innerHTML=ops.length?ops.map((o,i)=>{
   const st=["completed","active","pending"].includes(o.state)?o.state:"pending";
   const label=st==="completed"?"COMPLETED":st==="active"?"IN PROGRESS":(o.status||"QUEUED").toUpperCase();
   return '<div class="ppg-pro-journey-step '+st+'"><div class="ppg-pro-journey-node">'+(st==="completed"?icon("completed"):String(i+1))+'</div><strong>'+esc(o.operation||"Operation")+'</strong><p>'+esc(o.workstation||"Workstation not assigned")+'</p><span>'+esc(label)+'</span></div>';
  }).join(""):'<p style="color:#849087;font-size:10px;line-height:1.7">Actual production operations will appear here when linked to the order.</p>';

  $("ppg-pro-timeline").innerHTML=stages.length?stages.map(s=>{
   const st=["completed","active","pending"].includes(s.state)?s.state:"pending";
   return '<div class="ppg-pro-stage '+st+'"><div class="ppg-pro-stage-icon">'+icon(st)+'</div><div><strong>'+esc(s.label)+'</strong><p>'+esc(s.detail)+'</p>'+(s.date?'<time>'+esc(date(s.date))+'</time>':'')+'</div></div>';
  }).join(""):'<p style="color:#849087;font-size:10px">No delivery milestones recorded yet.</p>';

  $("ppg-pro-items").innerHTML=items.length?items.map(item=>{
   const image=item.image&&String(item.image).startsWith("/files/")
    ?'<img class="ppg-pro-item-img" src="'+esc(item.image)+'" alt="'+esc(item.item||"Product")+'">'
    :'<div class="ppg-pro-item-placeholder">PP</div>';
   const serial=item.serial_numbers?'<br>Serial no: '+esc(item.serial_numbers):"";
   return '<div class="ppg-pro-item">'+image+'<div><strong>'+esc(item.item||"Product")+'</strong><small>'+esc(item.item_code||"Item reference unavailable")+serial+'</small></div><div class="ppg-pro-item-qty">ORDERED<br>'+esc(item.qty)+'<br><span style="color:#849087">DELIVERED '+esc(item.delivered_qty)+'</span></div></div>';
  }).join(""):'<p style="color:#849087;font-size:10px">Order item details are not available.</p>';

  $("ppg-pro-pay-status").textContent=pay.status||"Payment information unavailable";
  $("ppg-pro-money-total").textContent=money(pay.order_total,pay.currency);
  $("ppg-pro-money-invoiced").textContent=money(pay.invoiced_amount,pay.currency);
  $("ppg-pro-money-paid").textContent=money(pay.paid_amount,pay.currency);
  $("ppg-pro-money-due").textContent=money(pay.balance_due,pay.currency);
  $("ppg-pro-copy").addEventListener("click",function(){
   if(navigator.clipboard&&navigator.clipboard.writeText){
    navigator.clipboard.writeText(token).then(()=>{$("ppg-pro-copy").textContent="Copied";}).catch(()=>{});
   }
  },{once:true});
 }
 if(!token){showError("Open the tracking search page and enter the Tracking ID shared by Power Partner.");return;}
 fetch("/api/method/ppg_dashboard.api.customer_tracking.get_order_tracking?tracking_id="+encodeURIComponent(token),{headers:{"Accept":"application/json"}})
 .then(async r=>{const body=await r.json();if(!r.ok)throw new Error("Unable to retrieve this order.");return body.message||{};})
 .then(data=>{if(!data.found){showError(data.message||"Tracking ID not found. Please check it and try again.");return;}render(data);})
 .catch(()=>showError("We could not load your order report. Please try again in a moment."));
})();
</script>
{% endblock %}
