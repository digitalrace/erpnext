<script>
(function(){
 const token=(new URLSearchParams(location.search).get("tracking_id")||"").trim().toUpperCase();
 const $=id=>document.getElementById(id);
 const loading=$("ppg-m-loading"),error=$("ppg-m-error"),content=$("ppg-m-content");
 function esc(v){return String(v==null?"":v).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}
 function date(v){if(!v)return "Not scheduled";const d=new Date(String(v).slice(0,10)+"T12:00:00");return isNaN(d)?String(v):d.toLocaleDateString("en-IN",{day:"2-digit",month:"short",year:"numeric"});}
 function money(v,c){try{return new Intl.NumberFormat("en-IN",{style:"currency",currency:c||"INR",maximumFractionDigits:2}).format(Number(v)||0)}catch(e){return(c||"INR")+" "+(Number(v)||0).toFixed(2)}}
 function icon(st){if(st==="completed")return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m5 12 4 4L19 6"/></svg>';if(st==="active")return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="8"/><path d="M12 7v5l3 2"/></svg>';return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="8"/></svg>'}
 function fail(msg){loading.style.display="none";content.style.display="none";error.style.display="block";$("ppg-m-error-text").textContent=msg||"Please check your Tracking ID and try again."}
 function render(d){
  const p=d.production||{},pay=d.payment||{},items=d.items||[],stages=d.stages||[],ops=p.operations||[];
  const delivery=Math.min(100,Math.max(0,Number(d.delivery_percent)||0));
  const prog=Math.min(100,Math.max(0,Number(p.progress_percent)||0));
  loading.style.display="none";error.style.display="none";content.style.display="block";
  $("ppg-m-token").textContent=token;
  $("ppg-m-order-ref").textContent=d.order_reference||"Order details";
  $("ppg-m-order-date").textContent=date(d.order_date);
  $("ppg-m-delivery-date").textContent=date(d.estimated_delivery_date);
  $("ppg-m-eta").textContent=date(d.estimated_delivery_date);
  $("ppg-m-eta-stat").textContent=date(d.estimated_delivery_date);
  $("ppg-m-status").textContent=d.overall_status||"Order confirmed";
  $("ppg-m-delivery-progress").textContent=delivery.toFixed(0)+"%";
  $("ppg-m-stage-stat").textContent=p.stage||"Awaiting production planning";
  $("ppg-m-stage-hint").textContent=p.workstation||"Workstation not assigned";
  $("ppg-m-order-value").textContent=money(pay.order_total,pay.currency);
  $("ppg-m-main-name").textContent=items.length?items[0].item:"Order items";
  $("ppg-m-main-code").textContent=items.length?(items[0].item_code||"Product details"): "Products linked to this order";
  $("ppg-m-main-img").innerHTML=items.length&&items[0].image&&String(items[0].image).startsWith("/files/")
   ?'<img class="ppg-mock-product-image" src="'+esc(items[0].image)+'" alt="'+esc(items[0].item||"Product")+'">'
   :'<div class="ppg-mock-product-fallback">PP</div>';
  $("ppg-m-operation").textContent=p.stage||"Awaiting production planning";
  $("ppg-m-prod-status").textContent=p.status||"Not Started";
  $("ppg-m-workstation").textContent=p.workstation||"Not assigned yet";
  $("ppg-m-production-qty").textContent=String(p.completed_qty||0)+" / "+String(p.stage_qty||0)+" units";
  $("ppg-m-stage-percent").textContent=prog.toFixed(0)+"%";
  $("ppg-m-stage-fill").style.width=prog+"%";
  $("ppg-m-photo-wrap").innerHTML=p.photo_url&&String(p.photo_url).startsWith("/files/")
   ?'<img class="ppg-mock-job-photo" src="'+esc(p.photo_url)+'" alt="Customer-shareable job photo">'
   :'<div class="ppg-mock-photo-placeholder"><span class="ppg-mock-photo-tag">CURRENT JOB PHOTO</span>No customer-shareable photo has been uploaded for this production stage yet.</div>';
  $("ppg-m-photo-caption").textContent=p.photo_url&&String(p.photo_url).startsWith("/files/")
   ?"Photo uploaded for the current operation.":"Your team can upload a customer-shareable photo from the Job Card.";
  $("ppg-m-operations").innerHTML=ops.length?ops.map(o=>{
   let s=["completed","active","pending"].includes(o.state)?o.state:"pending";
   return '<div class="ppg-mock-operation-row"><span class="ppg-mock-op-dot '+s+'"></span><div><strong>'+esc(o.operation||"Production operation")+'</strong><small>'+esc(o.workstation||"Workstation not assigned")+'</small></div><span class="ppg-mock-op-state">'+esc(o.status||"Pending")+'</span></div>';
  }).join(""):'<div style="color:#819087;font-size:10px;line-height:1.7;padding:8px 0">Work Order operations will appear here when production planning is linked to this Sales Order.</div>';
  $("ppg-m-journey").innerHTML=ops.length?ops.map((o,i)=>{
   let s=["completed","active","pending"].includes(o.state)?o.state:"pending";
   let label=s==="completed"?"COMPLETED":s==="active"?"IN PROGRESS":String(o.status||"QUEUED").toUpperCase();
   return '<div class="ppg-mock-journey-step '+s+'"><div class="ppg-mock-journey-node">'+(s==="completed"?icon(s):i+1)+'</div><strong>'+esc(o.operation||"Operation")+'</strong><p>'+esc(o.workstation||"Workstation not assigned")+'</p><span>'+esc(label)+'</span></div>';
  }).join(""):'<div style="color:#819087;font-size:10px;line-height:1.7">Actual operations will appear when the Work Order has been created.</div>';
  $("ppg-m-timeline").innerHTML=stages.length?stages.map(s=>{
   let st=["completed","active","pending"].includes(s.state)?s.state:"pending";
   return '<div class="ppg-mock-stage '+st+'"><div class="ppg-mock-stage-icon">'+icon(st)+'</div><div><strong>'+esc(s.label)+'</strong><p>'+esc(s.detail)+'</p>'+(s.date?'<time>'+esc(date(s.date))+'</time>':'')+'</div><span class="ppg-mock-stage-state">'+(st==="completed"?"COMPLETED":st==="active"?"IN PROGRESS":"PENDING")+'</span></div>';
  }).join(""):'<div style="color:#819087;font-size:10px">No delivery milestones recorded yet.</div>';
  $("ppg-m-items").innerHTML=items.length?items.map(it=>{
   const img=it.image&&String(it.image).startsWith("/files/")?'<img class="ppg-mock-item-img" src="'+esc(it.image)+'" alt="'+esc(it.item||"Product")+'">':'<div class="ppg-mock-item-fallback">PP</div>';
   const serial=it.serial_numbers?'<br>Serial no.: '+esc(it.serial_numbers):"";
   return '<div class="ppg-mock-item">'+img+'<div><strong>'+esc(it.item||"Product")+'</strong><small>'+esc(it.item_code||"Item reference unavailable")+serial+'</small></div><div class="ppg-mock-item-qty">ORDERED<br>'+esc(it.qty)+' units<br>DELIVERED '+esc(it.delivered_qty)+'</div></div>';
  }).join(""):'<div style="color:#819087;font-size:10px">Order item details are not available.</div>';
  $("ppg-m-pay-status").textContent=pay.status||"Payment information unavailable";
  $("ppg-m-money-total").textContent=money(pay.order_total,pay.currency);
  $("ppg-m-money-invoiced").textContent=money(pay.invoiced_amount,pay.currency);
  $("ppg-m-money-paid").textContent=money(pay.paid_amount,pay.currency);
  $("ppg-m-money-due").textContent=money(pay.balance_due,pay.currency);
 }
 $("ppg-m-copy").addEventListener("click",function(){
  if(navigator.clipboard&&navigator.clipboard.writeText)navigator.clipboard.writeText(token).then(()=>{$("ppg-m-copy").textContent="Copied";}).catch(()=>{});
 });
 if(!token){fail("Return to the tracking search page and enter your Tracking ID.");return}
 fetch("/api/method/ppg_dashboard.api.customer_tracking.get_order_tracking?tracking_id="+encodeURIComponent(token),{headers:{"Accept":"application/json"}})
 .then(async r=>{let body=await r.json();if(!r.ok)throw new Error();return body.message||{}})
 .then(d=>{if(!d.found){fail(d.message||"Tracking ID not found. Please check it and try again.");return}render(d)})
 .catch(()=>fail("We couldn't load your order report. Please try again in a moment."));
})();
</script>
