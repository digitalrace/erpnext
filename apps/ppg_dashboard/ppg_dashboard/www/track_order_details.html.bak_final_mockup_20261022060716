{% extends "templates/web.html" %}
{% block title %}Order Tracking | Power Partner Global{% endblock %}
{% block page_content %}
<style>
/* FULL-WIDTH MOCKUP-MATCHED CUSTOMER PORTAL */
body:has(.ppg-mockup-track){background:#f2f6ef!important;overflow-x:hidden}
body:has(.ppg-mockup-track) .navbar,
body:has(.ppg-mockup-track) header.navbar,
body:has(.ppg-mockup-track) .web-header,
body:has(.ppg-mockup-track) .web-footer,
body:has(.ppg-mockup-track) footer:not(.ppg-mock-footer){display:none!important}
body:has(.ppg-mockup-track) .page-content,
body:has(.ppg-mockup-track) .page-content-wrapper,
body:has(.ppg-mockup-track) .web-page-content,
body:has(.ppg-mockup-track) .main-section,
body:has(.ppg-mockup-track) .container{max-width:none!important}
body:has(.ppg-mockup-track) .page-content,
body:has(.ppg-mockup-track) .page-content-wrapper,
body:has(.ppg-mockup-track) .web-page-content{padding:0!important;margin:0!important}
.ppg-mockup-track,.ppg-mockup-track *{box-sizing:border-box}
.ppg-mockup-track{
 --forest:#103c30;--green:#246547;--lime:#d8f28a;
 --line:#e2eade;--muted:#748279;
 position:relative;left:calc(50% - 50vw);width:100vw;max-width:100vw;
 margin:0;background:#f2f6ef;color:#20362a;
 font-family:inherit;font-size:13px;overflow:hidden;
}
.ppg-mock-container{width:100%;max-width:1530px;margin:0 auto;padding-left:34px;padding-right:34px}
.ppg-mock-header{height:58px;background:#fff;border-bottom:1px solid #e6ebe3;display:flex;align-items:center}
.ppg-mock-header-inner{display:flex;align-items:center;gap:30px;width:100%}
.ppg-mock-brand{display:flex;align-items:center;gap:10px;min-width:275px}
.ppg-mock-logo{width:37px;height:37px;border-radius:50%;border:3px solid #74a95a;display:grid;place-items:center;color:#1c5a3e;font-size:12px;font-weight:950;letter-spacing:-1px;background:#eff5e9}
.ppg-mock-brand strong{display:block;color:#173c2c;font-size:13px;font-weight:950;letter-spacing:.5px}
.ppg-mock-brand small{display:block;color:#819085;font-size:8px;letter-spacing:1.6px;margin-top:3px}
.ppg-mock-nav{height:35px;display:flex;align-items:center;gap:9px;padding:0 0 1px;border-bottom:2px solid #2e6c49;color:#294737;font-size:10px;font-weight:900;letter-spacing:.8px;white-space:nowrap}
.ppg-mock-nav svg{width:18px;height:18px}
.ppg-mock-header-right{margin-left:auto;display:flex;align-items:center;gap:16px}
.ppg-mock-help-icon{width:28px;height:28px;display:grid;place-items:center;color:#245a40}
.ppg-mock-help-icon svg{width:23px;height:23px}
.ppg-mock-help-text{font-size:10px;color:#405549;line-height:1.6}
.ppg-mock-help-text strong{display:block;color:#254331}
.ppg-mock-contact-btn{display:inline-block;padding:11px 17px;border-radius:8px;background:var(--lime);color:#263f2b!important;font-size:10px;font-weight:900;text-decoration:none!important;white-space:nowrap}
.ppg-mock-cover{
 position:relative;color:#fff;
 background-color:#103c30;
 background-image:linear-gradient(90deg,rgba(8,47,36,.98) 0%,rgba(9,55,41,.93) 43%,rgba(9,48,37,.66) 100%),
 url("https://images.unsplash.com/photo-1567789884554-0b844b597180?auto=format&fit=crop&w=1900&q=85");
 background-size:cover;background-position:center 48%;
}
.ppg-mock-cover-inner{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:30px;align-items:center;min-height:176px;padding-top:22px;padding-bottom:22px}
.ppg-mock-kicker{color:#d8f28a;font-size:10px;font-weight:950;letter-spacing:1.55px}
.ppg-mock-cover h1{margin:11px 0 9px;color:#fff!important;font-size:clamp(30px,3vw,44px);line-height:1.1;letter-spacing:-1.15px;font-weight:900}
.ppg-mock-cover h1 span{color:#d8f28a}
.ppg-mock-cover p{max-width:710px;margin:0;color:#e1ebe4;font-size:12px;line-height:1.7}
.ppg-mock-token{justify-self:end;width:100%;max-width:290px;padding:17px 20px;border-radius:14px;background:#123f31e8;border:1px solid #c7e0c651;box-shadow:0 12px 30px #0002}
.ppg-mock-token-label{color:#c1d9c9;font-size:9px;font-weight:900;letter-spacing:1.35px}
.ppg-mock-token-row{display:flex;align-items:center;gap:8px;margin-top:8px}
.ppg-mock-token-row strong{flex:1;color:#fff;font-size:16px;overflow-wrap:anywhere}
.ppg-mock-copy{flex-shrink:0;border:0;border-radius:6px;background:#d8f28a;padding:7px;color:#24412d;font-size:10px;font-weight:900;cursor:pointer}
.ppg-mock-token-note{margin-top:7px;color:#c5dacb;font-size:9px}
.ppg-mock-order-strip{position:relative;z-index:2;display:grid;grid-template-columns:minmax(250px,1.65fr) repeat(5,minmax(105px,1fr));align-items:center;gap:0;padding:15px 17px;margin-top:-1px;border:1px solid var(--line);border-radius:0 0 13px 13px;background:#fff;box-shadow:0 8px 22px #183e2610}
.ppg-mock-order-product{display:flex;align-items:center;gap:12px;min-width:0;padding-right:14px}
.ppg-mock-product-image,.ppg-mock-product-fallback{width:68px;height:60px;flex:0 0 68px;object-fit:cover;border-radius:8px;background:#edf3e8}
.ppg-mock-product-fallback{display:grid;place-items:center;color:#50764d;font-size:11px;font-weight:950}
.ppg-mock-small-label{display:block;margin-bottom:5px;color:#7f8a80;font-size:9px;font-weight:950;letter-spacing:.75px}
.ppg-mock-product-name{display:block;color:#183b2d;font-size:13px;line-height:1.35;font-weight:900;overflow-wrap:anywhere}
.ppg-mock-product-code{display:block;margin-top:4px;color:#819084;font-size:9px;line-height:1.5;overflow-wrap:anywhere}
.ppg-mock-metric{display:flex;align-items:center;gap:8px;min-width:0;padding:7px 10px;border-left:1px solid #edf0eb}
.ppg-mock-metric-icon{width:30px;height:30px;flex:0 0 30px;border-radius:9px;background:#edf4e7;color:#36704b;display:grid;place-items:center}
.ppg-mock-metric-icon svg{width:16px;height:16px}
.ppg-mock-metric label{display:block;color:#899389;font-size:9px;line-height:1.45}
.ppg-mock-metric strong{display:block;margin-top:4px;color:#244331;font-size:11px;line-height:1.5;overflow-wrap:anywhere}
.ppg-mock-status-badge{display:inline-block;padding:5px 7px;border-radius:5px;background:#e6f3ae;color:#3e5723;font-size:9px;font-weight:950}
.ppg-mock-top-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:12px}
.ppg-mock-stat{padding:15px 17px;border:1px solid var(--line);border-radius:11px;background:#fff;min-width:0}
.ppg-mock-stat label{display:block;color:#829085;font-size:9px;font-weight:950;letter-spacing:.7px}
.ppg-mock-stat strong{display:block;margin-top:7px;color:#214b35;font-size:16px;line-height:1.5;overflow-wrap:anywhere}
.ppg-mock-stat small{display:block;margin-top:4px;color:#859188;font-size:10px;line-height:1.5}
.ppg-mock-main-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(360px,.95fr);gap:14px;margin-top:13px;align-items:start}
.ppg-mock-column{display:flex;flex-direction:column;gap:13px;min-width:0}
.ppg-mock-panel{padding:17px;border:1px solid var(--line);border-radius:13px;background:#fff;min-width:0}
.ppg-mock-panel-head{display:flex;align-items:center;gap:10px;margin-bottom:16px}
.ppg-mock-panel-icon{width:36px;height:36px;flex:0 0 36px;border-radius:10px;background:#eaf3e3;color:#32734b;display:grid;place-items:center}
.ppg-mock-panel-icon svg{width:18px;height:18px}
.ppg-mock-panel-head h2{margin:0;color:#203b2d;font-size:12px;line-height:1.4;font-weight:950;letter-spacing:.35px}
.ppg-mock-panel-head p{margin:4px 0 0;color:#819086;font-size:10px;line-height:1.5}
.ppg-mock-head-right{margin-left:auto;color:#7c8c80;font-size:9px;white-space:nowrap}
.ppg-mock-live-dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:#33a269;margin-right:5px}
.ppg-mock-production{display:grid;grid-template-columns:minmax(0,1.18fr) minmax(0,.98fr);gap:16px}
.ppg-mock-job-photo{width:100%;height:235px;display:block;object-fit:cover;border-radius:9px;background:#e9efe3}
.ppg-mock-photo-placeholder{height:235px;width:100%;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:10px;padding:20px;text-align:center;border:1px dashed #d4e0cd;border-radius:9px;background:#f5f8f1;color:#849185;font-size:10px;line-height:1.65}
.ppg-mock-photo-tag{padding:7px 10px;border-radius:6px;background:#e5f0d8;color:#486f42;font-size:9px;font-weight:950;letter-spacing:.6px}
.ppg-mock-photo-caption{margin-top:7px;color:#89958b;font-size:9px;line-height:1.5}
.ppg-mock-operation-label{color:#849087;font-size:9px;font-weight:950;letter-spacing:1px}
.ppg-mock-operation-name{margin:8px 0 9px;color:#1b5238;font-size:23px;line-height:1.2;font-weight:950;overflow-wrap:anywhere}
.ppg-mock-chip{display:inline-block;padding:6px 8px;border-radius:5px;background:#e8f3b5;color:#495d25;font-size:9px;font-weight:950}
.ppg-mock-machine-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:12px}
.ppg-mock-machine{display:flex;align-items:center;gap:7px;padding:8px;border:1px solid #e4ece0;border-radius:8px;min-width:0}
.ppg-mock-machine-icon{display:grid;place-items:center;width:29px;height:29px;flex:0 0 29px;background:#edf4e7;border-radius:8px;color:#3b704a}
.ppg-mock-machine-icon svg{width:15px;height:15px}
.ppg-mock-machine small{display:block;color:#89938a;font-size:8px}
.ppg-mock-machine strong{display:block;margin-top:3px;color:#365241;font-size:10px;line-height:1.4;overflow-wrap:anywhere}
.ppg-mock-progress-head{display:flex;justify-content:space-between;align-items:end;gap:8px;margin-top:17px}
.ppg-mock-progress-head span{color:#526a5a;font-size:10px;font-weight:850}
.ppg-mock-progress-head strong{color:#1e6641;font-size:23px;font-weight:950}
.ppg-mock-progress{height:8px;margin-top:7px;border-radius:9px;overflow:hidden;background:#e5ece1}
.ppg-mock-progress-fill{height:100%;background:linear-gradient(90deg,#176744,#72b76b);border-radius:9px}
.ppg-mock-divider{border:0;border-top:1px solid #e9eee5;margin:17px 0}
.ppg-mock-section-label{margin-bottom:6px;color:#53695a;font-size:9px;font-weight:950;letter-spacing:.65px}
.ppg-mock-operations{display:flex;flex-direction:column}
.ppg-mock-operation-row{display:grid;grid-template-columns:9px minmax(0,1fr) auto;align-items:center;gap:9px;padding:9px 0;border-bottom:1px solid #eff2ec}
.ppg-mock-operation-row:last-child{border-bottom:0}
.ppg-mock-op-dot{height:8px;width:8px;border-radius:50%;background:#cad4c7}
.ppg-mock-op-dot.completed{background:#2d8a58}
.ppg-mock-op-dot.active{background:#d0a340;box-shadow:0 0 0 3px #fbf1d5}
.ppg-mock-operation-row strong{display:block;color:#405648;font-size:10px}
.ppg-mock-operation-row small{display:block;color:#89948a;font-size:9px;margin-top:3px}
.ppg-mock-op-state{color:#829085;font-size:9px;white-space:nowrap}
.ppg-mock-timeline{display:flex;flex-direction:column}
.ppg-mock-stage{position:relative;display:grid;grid-template-columns:29px minmax(0,1fr) auto;gap:9px;align-items:start;padding-bottom:18px}
.ppg-mock-stage:last-child{padding-bottom:0}
.ppg-mock-stage:not(:last-child):before{content:"";position:absolute;left:13px;top:28px;bottom:0;width:2px;background:#e1e9dd}
.ppg-mock-stage-icon{position:relative;z-index:1;display:grid;place-items:center;width:28px;height:28px;border:1px solid #e0e7dc;border-radius:50%;background:#f2f6ef;color:#849184}
.ppg-mock-stage-icon svg{width:14px;height:14px}
.ppg-mock-stage.completed .ppg-mock-stage-icon{background:#248354;border-color:#248354;color:#fff}
.ppg-mock-stage.active .ppg-mock-stage-icon{background:#fff6da;border:2px solid #d2a541;color:#9a7317}
.ppg-mock-stage strong{display:block;margin-top:3px;color:#36503e;font-size:10px;line-height:1.5}
.ppg-mock-stage.completed strong{color:#286745}
.ppg-mock-stage p{margin:4px 0 0;color:#839087;font-size:9px;line-height:1.6}
.ppg-mock-stage time{display:block;margin-top:4px;color:#929b92;font-size:8px}
.ppg-mock-stage-state{padding:5px 6px;border-radius:5px;background:#eef1ed;color:#748176;font-size:8px;font-weight:950;white-space:nowrap}
.ppg-mock-stage.active .ppg-mock-stage-state{background:#fff0bb;color:#80601b}
.ppg-mock-eta{margin-top:16px;padding:15px;border:1px solid #e4eddd;border-radius:10px;background:#f2f7ed}
.ppg-mock-eta-label{color:#71846f;font-size:9px;font-weight:950;letter-spacing:.7px}
.ppg-mock-eta strong{display:block;margin-top:8px;color:#20553b;font-size:22px;font-weight:950}
.ppg-mock-eta p{margin:6px 0 0;color:#849082;font-size:9px;line-height:1.6}
.ppg-mock-journey{display:flex;align-items:flex-start;gap:0;overflow-x:auto;padding:7px 0 2px}
.ppg-mock-journey-step{position:relative;flex:1;min-width:100px;padding:0 6px;text-align:center}
.ppg-mock-journey-step:not(:last-child):after{content:"";position:absolute;top:14px;left:calc(50% + 17px);right:calc(-50% + 17px);height:2px;background:#dfe7db}
.ppg-mock-journey-node{position:relative;z-index:1;display:grid;place-items:center;width:29px;height:29px;margin:0 auto 8px;border-radius:50%;background:#e9eee6;color:#718076;font-size:10px;font-weight:950}
.ppg-mock-journey-step.completed .ppg-mock-journey-node{background:#2b8b58;color:#fff}
.ppg-mock-journey-step.active .ppg-mock-journey-node{background:#d8f28a;color:#30481f}
.ppg-mock-journey-step strong{display:block;color:#3a5141;font-size:9px;line-height:1.5}
.ppg-mock-journey-step p{margin:4px 0 7px;color:#849087;font-size:8px;line-height:1.5}
.ppg-mock-journey-step span{display:inline-block;padding:4px 5px;border-radius:5px;background:#edf1e9;color:#667866;font-size:7px;font-weight:950;white-space:nowrap}
.ppg-mock-journey-step.completed span{background:#dff0d6;color:#2b7044}
.ppg-mock-journey-step.active span{background:#e9f4b7;color:#4b632b}
.ppg-mock-items{display:flex;flex-direction:column;gap:7px}
.ppg-mock-item{display:grid;grid-template-columns:52px minmax(0,1fr) auto;align-items:center;gap:10px;padding:8px;border:1px solid #e9eee5;border-radius:9px}
.ppg-mock-item-img,.ppg-mock-item-fallback{width:52px;height:49px;object-fit:cover;border-radius:7px;background:#edf3e8}
.ppg-mock-item-fallback{display:grid;place-items:center;color:#52754f;font-size:10px;font-weight:950}
.ppg-mock-item strong{display:block;color:#344f3e;font-size:10px;line-height:1.5;overflow-wrap:anywhere}
.ppg-mock-item small{display:block;margin-top:3px;color:#8a958b;font-size:8px;line-height:1.5;overflow-wrap:anywhere}
.ppg-mock-item-qty{color:#4d694f;font-size:8px;line-height:1.6;text-align:right;white-space:nowrap}
.ppg-mock-pay-status{display:inline-block;margin-bottom:11px;padding:6px 8px;border-radius:6px;background:#edf4e3;color:#4d7146;font-size:9px;font-weight:950}
.ppg-mock-payment-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.ppg-mock-money{padding:12px;border:1px solid #e7eee3;border-radius:9px;background:#fafcf9;min-width:0}
.ppg-mock-money span{display:block;color:#849087;font-size:9px}
.ppg-mock-money strong{display:block;margin-top:7px;color:#304b3a;font-size:14px;line-height:1.4;overflow-wrap:anywhere}
.ppg-mock-money .paid{color:#27744b}
.ppg-mock-money.due{background:#fff8e9;border-color:#f2e2c4}
.ppg-mock-money.due strong{color:#995e18}
.ppg-mock-disclaimer{margin:10px 0 0;color:#879287;font-size:8px;line-height:1.6}
.ppg-mock-support{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:15px;border:1px solid #dfe9d8;border-radius:11px;background:#eaf3e4}
.ppg-mock-support strong{display:block;color:#34533d;font-size:11px}
.ppg-mock-support p{margin:5px 0 0;color:#7c897d;font-size:9px;line-height:1.6}
.ppg-mock-support a{flex-shrink:0;padding:10px 12px;border-radius:7px;background:#174a37;color:#fff!important;text-decoration:none!important;font-size:9px;font-weight:950;white-space:nowrap}
.ppg-mock-footer{background:#0c3429;color:#d5e4d9;padding:18px 0;margin-top:20px}
.ppg-mock-footer-inner{display:flex;align-items:center;justify-content:space-between;gap:18px}
.ppg-mock-footer-brand{font-size:10px;font-weight:950;letter-spacing:.5px}
.ppg-mock-footer-brand small{display:block;margin-top:4px;color:#91b39b;font-size:7px;letter-spacing:1.2px}
.ppg-mock-footer-links{display:flex;align-items:center;flex-wrap:wrap;gap:17px;color:#d7e5db;font-size:9px}
.ppg-mock-footer-links a{color:#d8f28a!important;text-decoration:none}
.ppg-mock-error{padding:28px;border:1px solid var(--line);border-radius:13px;background:#fff;text-align:center;color:#78867b}
.ppg-mock-error h2{margin:0 0 8px;color:#274934;font-size:19px}
.ppg-mock-error p{font-size:11px;line-height:1.7}
.ppg-mock-error a{display:inline-block;margin-top:8px;padding:10px 13px;border-radius:7px;background:var(--lime);color:#2b432e;text-decoration:none;font-size:10px;font-weight:950}
@media(max-width:1200px){
 .ppg-mock-order-strip{grid-template-columns:minmax(220px,1.4fr) repeat(3,minmax(120px,1fr));row-gap:7px}
 .ppg-mock-order-product{grid-column:1/-1;border-bottom:1px solid #edf0eb;padding-bottom:12px}
 .ppg-mock-metric:nth-child(2){border-left:0}
 .ppg-mock-main-grid{grid-template-columns:minmax(0,1.25fr) minmax(320px,.9fr)}
 .ppg-mock-container{padding-left:22px;padding-right:22px}
}
@media(max-width:850px){
 .ppg-mock-main-grid{grid-template-columns:1fr}
 .ppg-mock-production{grid-template-columns:1fr 1fr}
 .ppg-mock-order-strip{grid-template-columns:1fr 1fr}
 .ppg-mock-product-image,.ppg-mock-product-fallback{width:60px;height:56px;flex-basis:60px}
 .ppg-mock-metric{border-left:0;padding:6px}
 .ppg-mock-cover-inner{grid-template-columns:1fr auto;gap:15px}
 .ppg-mock-token{max-width:240px}
}
@media(max-width:560px){
 .ppg-mock-container{padding-left:12px;padding-right:12px}
 .ppg-mock-header{height:auto;min-height:58px}
 .ppg-mock-header-inner{gap:10px}
 .ppg-mock-brand{min-width:0;flex:1}
 .ppg-mock-brand strong{font-size:10px}
 .ppg-mock-brand small{font-size:7px;letter-spacing:.8px}
 .ppg-mock-nav,.ppg-mock-help-text{display:none}
 .ppg-mock-header-right{gap:5px}
 .ppg-mock-contact-btn{padding:9px;font-size:9px}
 .ppg-mock-cover-inner{grid-template-columns:1fr;padding-top:25px;padding-bottom:20px}
 .ppg-mock-cover h1{font-size:31px}
 .ppg-mock-token{justify-self:stretch;max-width:none;padding:12px}
 .ppg-mock-token-row strong{font-size:13px}
 .ppg-mock-order-strip{grid-template-columns:1fr 1fr;padding:10px}
 .ppg-mock-order-product{grid-column:1/-1;padding-bottom:10px}
 .ppg-mock-metric{padding:6px 0}
 .ppg-mock-metric-icon{display:none}
 .ppg-mock-metric strong{font-size:10px}
 .ppg-mock-top-stats{grid-template-columns:1fr;gap:7px}
 .ppg-mock-stat{padding:12px}
 .ppg-mock-main-grid{gap:10px;margin-top:10px}
 .ppg-mock-panel{padding:12px}
 .ppg-mock-panel-head{gap:7px}
 .ppg-mock-panel-head h2{font-size:11px}
 .ppg-mock-head-right{font-size:8px}
 .ppg-mock-production{grid-template-columns:1fr}
 .ppg-mock-job-photo{height:auto;max-height:280px}
 .ppg-mock-photo-placeholder{height:160px}
 .ppg-mock-operation-name{font-size:22px}
 .ppg-mock-machine-grid{grid-template-columns:1fr 1fr}
 .ppg-mock-stage{grid-template-columns:28px minmax(0,1fr) auto;gap:7px}
 .ppg-mock-stage-state{font-size:7px;padding:4px}
 .ppg-mock-payment-grid{gap:6px}
 .ppg-mock-money{padding:9px}
 .ppg-mock-money strong{font-size:12px}
 .ppg-mock-support{align-items:flex-start;flex-direction:column}
 .ppg-mock-footer-inner{align-items:flex-start;flex-direction:column}
 .ppg-mock-footer-links{gap:10px}
}
